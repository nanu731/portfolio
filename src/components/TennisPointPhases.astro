---
import Band from './Band.astro';
import DefinitionHelp from './DefinitionHelp.astro';
import approved from '../../scripts/tennis-viewer-copy.json';

const definitions = Object.entries({ ...approved.definitions, endingwin: {
	label: 'Win % of points ending here',
	copy: 'The selected player’s wins out of their wins plus losses on points that ended at this stage.'
} });
const inlineTerms = (html: string) => html.replace(/<button[^>]*data-definition="([^"]+)"[^>]*>(.*?)<\/button>/g,
	(_, id, label) => `<span data-tennis-inline-term="${id}">${label}</span>`);
const plainLimitations = approved.limitations.replace('All acquired years are exposed, and chart date labels do not verify historical availability.',
  'The data years have already been examined; recorded dates do not show when the information became available.');
const methodology = approved.methodology.slice(0, approved.methodology.indexOf('<p>Only the exact'))
  .replace('It remains owned exclusively by Rally; its breakdown adds no extra factor credit. Return belongs to Return, and Serve to Serve.',
    'Serve +1 is part of rally play and is shown separately here. Its points are not added to the totals a second time. Returns and serves retain their own action categories.')
  .replace('All acquired years are exposed; source-date labels do not establish historical availability.',
    'All years of data obtained for this project have already been examined, so none is an untouched test of a redesigned forecasting method. Recorded dates do not show when the information became available.');
---

<div class="tennis-explorer" data-tennis-explorer>
	<Band offset="edge">
		<p set:html={inlineTerms(approved.intro)} />
		<section class="tennis-guide" aria-labelledby="tennis-reading-guide">
			<h2 id="tennis-reading-guide">Reading these charts</h2>
			<p set:html={inlineTerms(approved.guide)} />
		</section>
	</Band>

	<Band offset="step">
		<div class="figure">
			<div class="tennis-controls" aria-label="Choose recorded points">
				<div><label for="tennis-category">Category</label><select id="tennis-category" data-tennis-control="category"><option value="ATP">Men’s</option><option value="WTA">Women’s</option></select></div>
				<div><label for="tennis-search">Find a player</label><input id="tennis-search" data-tennis-control="search" type="search" placeholder="Type a player name" autocomplete="off" /></div>
				<div><label for="tennis-player">Player</label><select id="tennis-player" data-tennis-control="player" disabled><option>Loading player names…</option></select></div>
				<div><label for="tennis-subset">Point selection</label><select id="tennis-subset" data-tennis-control="subset"><option value="ALL_INCLUDED">All included points</option><option value="BREAK_POINTS">Break points</option></select></div>
				<div><label for="tennis-match">Match view</label><select id="tennis-match" data-tennis-control="match" disabled><option>Choose a player first</option></select></div>
			</div>
			<p class="tennis-selector-note"><DefinitionHelp id="tennis-break-control" label="Break points explained" detailTarget="tennis-definition-break" detailLabel="See definitions">{approved.definitions.break.copy}</DefinitionHelp></p>
			<p class="tennis-selector-note" data-tennis-control="search-status" role="status"></p>
			<section id="tennis-view" data-tennis-control="view" aria-label="Selected player profile" aria-live="polite"><p>Loading recorded points…</p></section>
			<noscript><p>JavaScript is needed to load the charts. Definitions, methodology and source notices are readable below.</p></noscript>
		</div>
	</Band>

	<Band offset="edge" green>
		<section class="tennis-limitations" aria-labelledby="tennis-important-limitations">
			<h2 id="tennis-important-limitations">Important limitations</h2>
			<ul set:html={plainLimitations} />
		</section>
	</Band>

	<Band offset="step">
		<details class="tennis-reference" id="tennis-definitions">
			<summary>Definitions</summary>
			<button type="button" class="tennis-definition-return" data-tennis-definition-return hidden>Return to the term</button>
			{definitions.map(([id, definition]) => <section>
				<h3 id={`tennis-definition-${id}`} tabindex={-1} data-reference-target>{definition.label}</h3>
				<p>{definition.copy}</p>
			</section>)}
		</details>
	</Band>

	<Band offset="edge">
		<details class="tennis-reference" id="tennis-methodology">
			<summary>Methodology</summary>
			<div set:html={methodology} />
			<p>Only the exact men’s-category Dominik Koepfer identity is hidden from selection. All 450 identities and their profiles remain in the frozen display release. This page loads the selected player’s aggregates; no historical data is removed or recalculated.</p>
			<p>These charts use the modern point-phase and break-point/ending-type releases. Their identifiers, source pins and file fingerprints are in the <a href="/data/tennis-viewer-manifest-v1.json">display release record</a>. The <a href="https://github.com/nanu731/tennis-analytics">analysis repository</a> is public; the latest local viewer implementation has not yet been released there.</p>
			<p>The viewer reuses the website’s self-hosted Fraunces, Source Serif 4 and IBM Plex Mono fonts. Full copyright and license notices are linked below.</p>
		</details>
	</Band>

	<Band offset="edge">
		<section class="tennis-licenses" aria-labelledby="tennis-licenses">
			<h2 id="tennis-licenses">Sources and licenses</h2>
			<p>Source: <a href="https://github.com/JeffSackmann/tennis_MatchChartingProject">The Tennis Abstract Match Charting Project</a>, by Jeff Sackmann and <a href="http://www.tennisabstract.com/charting/meta.html#contributors">contributors</a>.</p>
			<p>The source is licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>. The adapted display material includes parsed notation, conservative inclusion checks, neutral player perspectives, point-stage and recorded-ending classifications, and pooled display counts. <a href="/tennis-mcp-notice.txt">Full source, changes and applicable license notice</a>. The adapted tennis display material is also provided under CC BY-NC-SA 4.0; this does not relicense unrelated website material. No provider endorsement is implied.</p>
			<p>Font copyright and full SIL Open Font License notices: <a href="/fraunces-license.txt">Fraunces</a>, <a href="/source-serif-license.txt">Source Serif 4</a>, <a href="/ibm-plex-license.txt">IBM Plex Mono</a>. These notices concern fonts; the MCP notice concerns adapted data.</p>
		</section>
	</Band>

	{definitions.map(([id, definition]) => <template data-tennis-term={id}>
		<DefinitionHelp id={`tennis-template-${id}`} label={definition.label} detailTarget={`tennis-definition-${id}`} detailLabel="See definitions">{definition.copy}</DefinitionHelp>
	</template>)}
</div>

<script>
	import '../lib/tennis-viewer.mjs';
</script>

<style is:global>
	.tennis-explorer { --tennis-bar-label: calc(3.5 * var(--type-small)); --tennis-bar-value: calc(11 * var(--type-small)); }
	.tennis-explorer .tennis-guide { margin-top: var(--space-l); }
	.tennis-explorer .tennis-guide h2 { font-size: var(--type-h3); }
	.tennis-explorer .tennis-controls { display: grid; grid-template-columns: minmax(0, .7fr) repeat(2, minmax(0, 1fr)) minmax(0, .9fr) minmax(0, 1.2fr); gap: var(--space-s); padding-block: var(--space-s); border-block: var(--rule-thick) solid var(--green); }
	.tennis-explorer .tennis-controls > div { min-width: 0; }
	.tennis-explorer label { display: block; font-size: var(--type-small); font-weight: 600; margin-bottom: var(--space-3xs); }
	.tennis-explorer select, .tennis-explorer input { font: inherit; width: 100%; min-width: 0; min-height: calc(var(--space-l) + var(--space-3xs)); padding: var(--space-2xs); border: var(--rule) solid var(--green); border-radius: 0; color: var(--green); background: var(--cream); }
	.tennis-explorer input:focus-visible, .tennis-explorer select:focus-visible, .tennis-explorer summary:focus-visible, .tennis-explorer button:focus-visible { outline: var(--rule-thick) solid var(--green); outline-offset: var(--space-3xs); }
	.tennis-explorer .tennis-selector-note { margin-block: var(--space-2xs); font-size: var(--type-small); }
	.tennis-explorer .section { border-top: var(--rule) solid var(--green); padding-block: var(--space-l); }
	.tennis-explorer .section h2, .tennis-explorer .coverage h2 { font-size: var(--type-h3); }
	.tennis-explorer .section h3 { font-size: var(--type-body); }
	.tennis-explorer .coverage { padding-block: var(--space-s) var(--space-l); }
	.tennis-explorer .profile-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2xs); align-items: baseline; }
	.tennis-explorer .profile-heading h2 { margin: 0; }
	.tennis-explorer .small, .tennis-explorer .coverage-note, .tennis-explorer .context { font-size: var(--type-small); }
	.tennis-explorer .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-s); margin-top: var(--space-s); }
	.tennis-explorer .stat strong { display: block; font-size: var(--type-body); }
	.tennis-explorer .stat span { display: block; font-size: var(--type-small); }
	.tennis-explorer .numeric, .tennis-explorer .counts, .tennis-explorer .stat strong, .tennis-explorer .scale, .tennis-explorer .match-id { font-family: var(--font-mono), monospace; font-variant-numeric: tabular-nums; }
	.tennis-explorer .context, .tennis-explorer .match-id, .tennis-explorer .technical { overflow-wrap: anywhere; }
	.tennis-explorer .warning { font-weight: 600; color: var(--accent); }
	.tennis-explorer .phase { margin-block: var(--space-s) var(--space-m); }
	.tennis-explorer .phase-name { font-size: var(--type-small); font-weight: 600; }
	.tennis-explorer .bar-line { display: grid; grid-template-columns: var(--tennis-bar-label) minmax(0, 1fr) var(--tennis-bar-value); align-items: center; gap: var(--space-2xs); margin-block: var(--space-3xs); font-size: var(--type-small); }
	.tennis-explorer .track { height: var(--space-s); background: var(--sand); }
	.tennis-explorer .fill { height: 100%; background: var(--green); }
	.tennis-explorer .fill.loss { background-color: var(--accent); background-image: repeating-linear-gradient(135deg, transparent 0 var(--space-3xs), var(--cream) var(--space-3xs) calc(var(--space-3xs) + var(--rule))); }
	.tennis-explorer .bar-value { text-align: right; }
	.tennis-explorer .scale { display: flex; justify-content: space-between; font-size: var(--type-small); margin-block: var(--space-s) var(--space-2xs); margin-inline: calc(var(--tennis-bar-label) + var(--space-2xs)) calc(var(--tennis-bar-value) + var(--space-2xs)); }
	.tennis-explorer .reach-row { display: grid; grid-template-columns: 10em minmax(0, 1fr) 5em; align-items: center; gap: var(--space-2xs); margin-block: var(--space-s); font-size: var(--type-small); }
	.tennis-explorer .reach-row strong { text-align: right; }
	.tennis-explorer .reach-row .counts { grid-column: 2 / -1; }
	.tennis-explorer .roles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-m); align-items: start; }
	.tennis-explorer .role h3 { margin-top: 0; }
	.tennis-explorer .role-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-2xs); border-top: var(--rule) solid var(--sand); padding-block: var(--space-2xs); font-size: var(--type-small); }
	.tennis-explorer .role-row .counts { grid-column: 1 / -1; }
	.tennis-explorer .unavailable { padding-block: var(--space-2xs); font-style: italic; }
	.tennis-explorer .zero-details { border-top: var(--rule) solid var(--sand); }
	.tennis-explorer summary { cursor: pointer; font-weight: 600; padding-block: var(--space-s); }
	.tennis-explorer .tennis-reference { border-top: var(--rule) solid var(--green); }
	.tennis-explorer .tennis-reference > summary { font-size: var(--type-h3); }
	.tennis-explorer .tennis-reference h3 { scroll-margin-top: var(--space-l); }
	.tennis-explorer [data-tennis-retry], .tennis-explorer .tennis-definition-return { min-height: calc(var(--space-l) + var(--space-3xs)); border: var(--rule) solid var(--green); background: var(--cream); color: var(--green); padding: var(--space-2xs) var(--space-s); font: inherit; }
	.tennis-explorer [hidden] { display: none !important; }
	.tennis-explorer .tennis-licenses h2 { font-size: var(--type-h3); }
	@media (max-width: 48rem) {
		.tennis-explorer .tennis-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.tennis-explorer .tennis-controls > div:last-child { grid-column: 1 / -1; }
		.tennis-explorer .roles { grid-template-columns: 1fr; }
	}
	@media (max-width: 30rem) {
		.tennis-explorer .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.tennis-explorer .tennis-controls > div:nth-child(3), .tennis-explorer .tennis-controls > div:nth-child(4) { grid-column: 1 / -1; }
		.tennis-explorer { --tennis-bar-label: calc(5 * var(--type-small)); --tennis-bar-value: calc(8 * var(--type-small)); }
		.tennis-explorer .bar-line > span:first-child { white-space: nowrap; }
		.tennis-explorer .bar-value { font-size: var(--type-label); }
		.tennis-explorer .scale { font-size: var(--type-label); }
		.tennis-explorer .reach-row { grid-template-columns: 7em minmax(0, 1fr) 4.5em; }
		.tennis-explorer .reach-row .counts { grid-column: 1 / -1; }
	}
</style>
