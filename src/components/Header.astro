---
import { SITE_TITLE } from '../consts';
import manifest from '../prepared-projects/manifest.json';
import { getPreparedProject } from '../lib/prepared-projects';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => path === (href.replace(/\/$/, '') || '/') ? 'page' : undefined;
const projects = manifest.projects.map(({ slug }) => getPreparedProject(slug)!);
const comparison = projects.find(project => project.kind === 'comparison');
const links = [['/blog/', 'Blog'], ['/about/', 'About'], ['/contact/', 'Contact'], ['https://github.com/nanu731', 'GitHub']];
---
<header class="portfolio-header">
  <a class="portfolio-skip" href="#main-content">Skip to main content</a>
  <div class="portfolio-mast">
    <a class="portfolio-brand" href="/"><img src="/nsl-logo.svg" width="344" height="156" alt="" />{SITE_TITLE}</a>
    {path === '/projects/tennis-shots-and-errors' &&
      <button class="portfolio-mobile-toggle" type="button" aria-expanded="false" aria-controls="portfolio-primary" hidden>Menu</button>}
    <nav id="portfolio-primary" aria-label="Primary navigation">
      <a href="/" aria-current={current('/')}>Home</a>
      <details class="portfolio-projects">
        <summary aria-label={path.startsWith('/projects') ? 'Projects, current section' : undefined} class:list={[{ 'current-section': path.startsWith('/projects') }]}>Projects</summary>
        <div class="portfolio-menu">
          <a href="/projects/" aria-current={current('/projects/')}>All projects</a>
          {projects.filter(project => project.kind !== 'comparison').map(project => (
            <>
              <a href={`/projects/${project.slug}/`} aria-current={current(`/projects/${project.slug}/`)}>{project.title}</a>
              {project.kind === 'shots' && comparison &&
                <a class="subproject" href={`/projects/${comparison.slug}/`} aria-current={current(`/projects/${comparison.slug}/`)}>{comparison.title}</a>}
            </>
          ))}
        </div>
      </details>
      {links.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
    </nav>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.portfolio-projects');
  if (menu) {
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('focusin', event => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.portfolio-mobile-toggle');
  if (toggle) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true'));
    });
    toggle.closest('header')?.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true' ||
          toggle.offsetParent === null || document.querySelector('.portfolio-projects[open]')) return;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus();
    });
  }
</script>
