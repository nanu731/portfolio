---
import {readFile} from 'node:fs/promises';
import DefinitionHelp from './DefinitionHelp.astro';
import {validatePair,DATA_URL,MANIFEST_URL,fmt,evidence,interval,studyLabel} from '../lib/nfl-comparison';
const data=await validatePair(await readFile('public'+DATA_URL),await readFile('public'+MANIFEST_URL));
import {validateAnnualDepth,ANNUAL_URL,ANNUAL_MANIFEST_URL,DEPTH_URL,DEPTH_MANIFEST_URL} from '../lib/nfl-annual';
const {annual,depth}=await validateAnnualDepth(...await Promise.all([ANNUAL_URL,ANNUAL_MANIFEST_URL,DEPTH_URL,DEPTH_MANIFEST_URL].map(url=>readFile('public'+url))) as [Uint8Array,Uint8Array,Uint8Array,Uint8Array]);
import {buildPercentileReferences,percentileFor,displayPercentile} from '../lib/nfl-percentiles';
import {EXPERT_SOURCE,EXPERT_RANKS,validateExpertRanks,expertFor} from '../lib/nfl-experts';
validateExpertRanks(EXPERT_RANKS);
const references=await buildPercentileReferences(annual,depth,data);
const staticMetrics=['sack_avoidance_pct','scramble_contribution','short_cpoe_pp','medium_cpoe_pp','deep_cpoe_pp'];
const staticRank=(i:number,j:number)=>percentileFor(references,staticMetrics[i],2023,defaults[j].annual.player_key);
const players=[...new Map(annual.rows.map(r=>[r.player_key,r])).values()].sort((a,b)=>a.display_name.localeCompare(b.display_name));
const seasons=[...annual.season_catalog].sort((a,b)=>b.season-a.season);
const defaults=['00-0033873','00-0034857'].map(id=>({annual:annual.rows.find(r=>r.player_key===id&&r.season===2023)!,legacy:data.rows.find(r=>r.player_key===id&&r.season===2023)!,depth:depth.rows.filter(r=>r.player_key===id&&r.season===2023)}));
const staticOutcomes=['Dropbacks without a sack (%)','Scramble expected points per included QB play','Short completions above expectation (pp)','Medium completions above expectation (pp)','Deep completions above expectation (pp)'];
const staticValue=(i:number,j:number)=>i===0?defaults[j].annual.sack_avoidance_pct:i===1?defaults[j].legacy.scramble_contribution:defaults[j].depth.find(r=>r.bin===['short','medium','deep'][i-2])!.cpoe_pp;
const staticEvidence=(i:number,j:number)=>{
 const d=defaults[j];
 if(i===0)return `${d.annual.sacks} sacks / ${d.annual.dropbacks} dropbacks in ${d.annual.dropback_games} games; raw range not estimated.`;
 if(i===1)return `${d.legacy.scramble_runs} scrambles / ${d.legacy.combined_opportunities} included QB plays in ${d.legacy.combined_games} games; raw range ${fmt(d.legacy.scramble_contribution_lower)} to ${fmt(d.legacy.scramble_contribution_upper)} expected points per included QB play; ${String(d.legacy.scramble_interval_status).replaceAll('_',' ')}.`;
 const r=d.depth.find(r=>r.bin===['short','medium','deep'][i-2])!;
 return `${r.bin_throws} throws; ${r.positive_bin_games} positive-bin games / ${r.eligible_games} included-throw games; raw range ${fmt(r.lower)} to ${fmt(r.upper)} pp; ${r.interval_status.replaceAll('_',' ')}.`;
};
// Display names: nflverse players.csv, GSIS-keyed; verified2026-10-19.
// https://github.com/nflverse/nflverse-data/releases/download/players/players.csv
const displayNames:Record<string,string> = {"00-0026498": "Matthew Stafford", "00-0029263": "Russell Wilson", "00-0030565": "Geno Smith", "00-0031280": "Derek Carr", "00-0033106": "Jared Goff", "00-0033873": "Patrick Mahomes", "00-0034796": "Lamar Jackson", "00-0034855": "Baker Mayfield", "00-0034857": "Josh Allen", "00-0035289": "Gardner Minshew", "00-0036212": "Tua Tagovailoa", "00-0036264": "Jordan Love", "00-0036355": "Justin Herbert", "00-0036389": "Jalen Hurts", "00-0036442": "Joe Burrow", "00-0036971": "Trevor Lawrence", "00-0036972": "Mac Jones", "00-0037834": "Brock Purdy", "00-0039150": "Bryce Young", "00-0039163": "C.J. Stroud"};
const nameOf=(r:typeof data.rows[number])=>displayNames[r.player_key]??r.observed_name;

---
<nfl-comparison data-state="loading">
 <section aria-label="Compare two quarterbacks">
  <div class="fan-controls">
   <div class="comparison-side" role="group" aria-label="Quarterback A and season">
    <div class="player-season">
     <div class="player-combobox">
      <label class="label" for="nfl-search-a">Quarterback A</label>
      <p class="search-help" id="nfl-search-help-a">Open the list or type a name. Accents and punctuation are optional.</p>
      <div class="combobox-shell" data-combobox-a>
       <input id="nfl-search-a" type="search" data-search-a value={players.find(r=>r.player_key==='00-0033873')!.display_name} placeholder="Search players in 2023" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="nfl-suggestions-a" aria-describedby="nfl-search-help-a nfl-search-status-a" autocomplete="off" disabled />
       <div id="nfl-suggestions-a" class="suggestion-menu" role="listbox" aria-label="Quarterbacks for A" data-suggestions-a hidden></div>
      </div>
      <select id="nfl-player-a" name="nfl-player-a" data-a aria-label="Selected quarterback A" hidden disabled>{players.map(r=><option value={r.player_key} selected={r.player_key==='00-0033873'}>{r.display_name}</option>)}</select>
     </div>
     <label class="label season-control" for="nfl-season-a">Season A<select id="nfl-season-a" name="nfl-season-a" data-season-a disabled>{seasons.map(y=><option value={y.season} selected={y.season===2023}>{y.season}{y.status==='source_blocked'?' · source blocked':''}</option>)}</select></label>
    </div>
    <p class="search-status" id="nfl-search-status-a" data-search-status-a role="status" aria-live="polite"></p>
   </div>
   <div class="comparison-side" role="group" aria-label="Quarterback B and season">
    <div class="player-season">
     <div class="player-combobox">
      <label class="label" for="nfl-search-b">Quarterback B</label>
      <p class="search-help" id="nfl-search-help-b">Open the list or type a name. Accents and punctuation are optional.</p>
      <div class="combobox-shell" data-combobox-b>
       <input id="nfl-search-b" type="search" data-search-b value={players.find(r=>r.player_key==='00-0034857')!.display_name} placeholder="Search players in 2023" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="nfl-suggestions-b" aria-describedby="nfl-search-help-b nfl-search-status-b" autocomplete="off" disabled />
       <div id="nfl-suggestions-b" class="suggestion-menu" role="listbox" aria-label="Quarterbacks for B" data-suggestions-b hidden></div>
      </div>
      <select id="nfl-player-b" name="nfl-player-b" data-b aria-label="Selected quarterback B" hidden disabled>{players.map(r=><option value={r.player_key} selected={r.player_key==='00-0034857'}>{r.display_name}</option>)}</select>
     </div>
     <label class="label season-control" for="nfl-season-b">Season B<select id="nfl-season-b" name="nfl-season-b" data-season-b disabled>{seasons.map(y=><option value={y.season} selected={y.season===2023}>{y.season}{y.status==='source_blocked'?' · source blocked':''}</option>)}</select></label>
    </div>
    <p class="search-status" id="nfl-search-status-b" data-search-status-b role="status" aria-live="polite"></p>
   </div>
  </div>
  <p class="coverage">2006–2025 regular seasons · 560 qualifying player-seasons. 2011 data is blocked. <a href="#nfl-definition-annual">Who qualifies each year?</a></p>
  <div class="selection-availability" aria-label="Selected player-season availability"><p data-availability-a role="status" aria-live="polite"></p><p data-availability-b role="status" aria-live="polite"></p></div>
  <p class="limit" hidden>Season comparisons also reflect teammates, opponents and model differences; they do not isolate improvement.</p>
  <p class="availability" data-comparison-status role="status" aria-live="polite">Checking comparison data…</p><button type="button" data-retry hidden>Retry comparison data</button>
  <section class="radar-prototype" aria-labelledby="nfl-radar-heading">
   <h2 id="nfl-radar-heading">Quarterback attribute profile</h2>
   <p class="profile-window" data-profile-window>Expert opinions: Mahomes and Allen, preseason 2023 only. Stats: 2023 regular season.</p>
   <p class="radar-intro">Two expert opinions and five season-stat indicators, not seven measured abilities. Processing uses ESPN’s field-vision opinion.</p>
   <button type="button" data-complete-example disabled>Load complete 2023 example</button>
   <p class="radar-key" data-radar-legend></p>
   <noscript><p>The radar requires JavaScript. All seven default positions appear below: Patrick Mahomes · 2023 (A) and Josh Allen · 2023 (B). Expert assessments predate the season; outcome values describe the regular season.</p><div class="table-scroll" role="region" aria-label="Static default seven-attribute comparison" tabindex="0"><table data-static-default><thead><tr><th scope="col">Position / evidence</th><th scope="col">A · Patrick Mahomes · 2023</th><th scope="col">B · Josh Allen · 2023</th></tr></thead><tbody>
    {(['arm_strength','field_vision'] as const).map(trait=><tr><th scope="row">{trait==='arm_strength'?'Arm strength':'Processing proxy · field vision'}</th>{defaults.map(d=><td data-static-expert={trait}>#{expertFor(trait,2023,d.annual.player_key)!.rank} expert rank<br/><a href={EXPERT_SOURCE.url}>ESPN Quarterback Council · 14 Aug 2023</a><br/>Preseason editorial assessment; drawing index only.</td>)}</tr>)}
    {staticOutcomes.map((label,i)=><tr><th scope="row">{label}</th>{[0,1].map(j=><td>{displayPercentile(staticRank(i,j).percentile)} percentile<br/>2023 · {i===1?'original 20-QB cohort':'annual eligible peers'} · N={staticRank(i,j).n}<br/>Recorded value: {fmt(staticValue(i,j),i===0?1:3)}<br/>{staticEvidence(i,j)} Raw ranges are not percentile intervals.</td>)}</tr>)}</tbody></table></div></noscript>
   <div class="radar-layout">
    <figure class="radar-figure">
     <p class="radar-series-key"><span><svg viewBox="0 0 44 20" aria-hidden="true"><line x1="0" y1="10" x2="44" y2="10" class="series-a"/><circle cx="22" cy="10" r="4.5" class="mark-a"/></svg>A · circle, solid line</span><span><svg viewBox="0 0 44 20" aria-hidden="true"><line x1="0" y1="10" x2="44" y2="10" class="series-b"/><path d="M22 2 L30 10 L22 18 L14 10 Z" class="mark-b"/></svg>B · open diamond, dashed line</span></p>

     <div data-chart-host><svg id="nfl-radar" data-radar hidden role="group" aria-labelledby="nfl-radar-title nfl-radar-description"></svg></div>
     <figcaption>A lower expert rank (#) is better. A higher percentile means higher standing for that season stat. Compare one attribute at a time; a bigger shape is not better overall. Mobility uses the original 20-player group. Select an underlined attribute for its guide.</figcaption>
    </figure>
    <div class="profile-readout"><table aria-label="Selected attribute values"><thead><tr><th scope="col">Attribute</th><th scope="col" data-profile-a>A</th><th scope="col" data-profile-b>B</th></tr></thead><tbody data-profile-values></tbody></table></div>
   </div>
   <p class="evidence-gaps" data-radar-gaps hidden></p>
   <details class="radar-detail"><summary>Expert sources, recorded values, counts and raw ranges</summary>
    <p>EPA/O means expected points added per included quarterback play. D means recorded dropbacks; O includes those dropbacks and non-scramble quarterback runs. A raw conditional range describes game-sampling variation in the original units under study assumptions. It is not a percentile interval, every source of uncertainty or a test of the difference between players.</p>
    <div class="radar-values table-scroll" role="region" aria-label="Clockwise evidence map and selected values in original units" tabindex="0">
     <table class="radar-table"><caption>Clockwise evidence map · original units</caption><thead><tr><th scope="col">Position / evidence</th><th scope="col" data-radar-a>Quarterback A</th><th scope="col" data-radar-b>Quarterback B</th></tr></thead><tbody data-radar-values></tbody></table>
    </div>
    <p class="radar-counts" data-radar-counts></p>
    <p>Four outcomes use annual eligible peers; scramble uses the original 20-QB cohort in 2023 or 2024. Equal percentile gaps need not mean equal outcome or ability gaps. The three depth outcomes share context and correlated evidence, so they are not independent skill votes. Raw game-based ranges are not percentile intervals.</p>
    <p>Teammates, opponents and model versions can differ across seasons. These observed summaries do not measure isolated skill or improvement. Model versions and calibration are unknown across eras.</p>
    <p class="radar-limits">The pocket-presence and mobility traits are not directly measured. Sack avoidance also reflects protection and receivers; scramble contribution combines usage with shared play value and omits other runs and athletic movement.</p>
   <p class="radar-scale"><DefinitionHelp id="nfl-radar-radius" label="How the radius works" detailTarget="nfl-radar-scaling" detailLabel="Two drawing scales, sources and limits">Expert ranks use (11 − rank) / 10 as an ordinal drawing index. The other five spokes use their accepted outcome percentile divided by 100. Equal distances across these scales do not mean equal skill. Missing ranks and outcomes stay unavailable; neither scale gives an overall grade.</DefinitionHelp> · <a href="#nfl-radar-scaling">Two scales, sources and limitations</a></p>
   </details>
   <details class="selected-depth"><summary>Selected depth records: values, counts and raw ranges</summary><p>Four bins per available player-season. Negative air yards are diagnostic only and do not appear on the radar. Raw E-game ranges include games with no throws in that bin. They are not percentile intervals.</p><div class="table-scroll" role="region" aria-label="Selected depth records" tabindex="0"><table><thead><tr><th scope="col">Side / player / year / bin</th><th scope="col">CPOE (pp)</th><th scope="col">Throws / games</th><th scope="col">Raw conditional range / status</th></tr></thead><tbody data-selected-depth></tbody></table></div></details>

  </section>
  <details class="comparison-evidence" data-comparison-evidence>
   <summary>Inspect EPA, completion and sack comparisons in their original units</summary>
  <section class="reading-guide" aria-labelledby="nfl-reading-heading">
   <h2 id="nfl-reading-heading">How to read</h2>
   <p>Filled circle: A. Open diamond: B. Farther right means a higher value on that stat’s scale. Zero means no modeled net gain for EPA, or matching expected completions for CPOE. EPA bars show uncertainty around each summary; individual CPOE ranges were not estimated. These descriptive season summaries use each stat’s own units and do not give an overall quarterback rating.</p>
  </section>
  <div class="primary-comparisons">
   <figure class="fan-comparison" aria-labelledby="nfl-value-heading">
    <h2 id="nfl-value-heading"><DefinitionHelp id="nfl-value" label="Value per dropback" detailTarget="nfl-definition-epa-dropback" detailLabel="Formula and limits">How much the offense’s scoring outlook improved, on average, on this quarterback’s passes, sacks and scrambles.</DefinitionHelp></h2>
    <p class="explanation">How much the offense’s scoring outlook improved, on average, on this quarterback’s passes, sacks and scrambles.</p>
    <p class="unit"><DefinitionHelp id="nfl-expected-points" label="Expected points" detailTarget="nfl-definition-ep" detailLabel="Model and limits">The model's value of a game situation, based on chances of the next scoring event in the half.</DefinitionHelp> per <DefinitionHelp id="nfl-dropback" label="recorded dropback" detailTarget="nfl-definition-populations" detailLabel="Definition and limits">Recorded passes, sacks and scrambles.</DefinitionHelp> (<DefinitionHelp id="nfl-epa" label="EPA" detailTarget="nfl-definition-epa" detailLabel="Formula and limits">How much a play improved or worsened the offense's expected points.</DefinitionHelp> per dropback). Higher means more recorded scoring value.</p>
    <div data-chart-host><svg id="nfl-epa-plot" data-field="epa_per_dropback" hidden role="img" aria-labelledby="nfl-epa-plot-title nfl-epa-plot-description"></svg></div>
    <figcaption>Bars show a <DefinitionHelp id="nfl-range" label="95% game-based range" detailTarget="nfl-method-uncertainty" detailLabel="Formula and limits">An approximate range based on game-to-game variation, under the study's assumptions. These conditional ranges are not probabilities for true talent, predictions for next season or bounds on every source of uncertainty.</DefinitionHelp> around each summary. They do not test the difference between players.</figcaption>
    <p class="counts" data-counts="epa"></p>
    <details class="pair-evidence" data-evidence="epa_per_dropback"><summary>Values, counts and ranges</summary><div class="table-scroll" role="region" aria-label="Selected value per dropback records" tabindex="0"><table><caption>Expected points per recorded dropback. Source counts and marginal conditional ranges.</caption><thead><tr><th scope="col">Quarterback</th><th scope="col">Value</th><th scope="col">Included dropbacks</th><th scope="col">Range / status</th></tr></thead><tbody data-selected-values></tbody></table></div></details>
   </figure>
   <figure class="fan-comparison" aria-labelledby="nfl-completion-heading">
    <h2 id="nfl-completion-heading"><DefinitionHelp id="nfl-completions" label="Completions above expectation" detailTarget="nfl-definition-cpoe" detailLabel="Formula and limits">How many more or fewer passes were completed per 100 included throws than the model expected.</DefinitionHelp></h2>
    <p class="explanation">How many more or fewer passes were completed per 100 included throws than the model expected.</p>
    <p class="unit"><DefinitionHelp id="nfl-percentage-points" label="Percentage points" detailTarget="nfl-definition-percentage-points" detailLabel="Definition and formula">Percentage points are differences between percentages, not percent improvement or a percentile.</DefinitionHelp> (<DefinitionHelp id="nfl-cpoe" label="CPOE" detailTarget="nfl-definition-cpoe" detailLabel="Formula and limits">How far the player's completion rate finished above or below the model's expectation for the included throws.</DefinitionHelp>). Higher means more completions above expectation.</p>
    <div data-chart-host><svg id="nfl-cpoe-plot" data-field="cpoe_pp" hidden role="img" aria-labelledby="nfl-cpoe-plot-title nfl-cpoe-plot-description"></svg></div>
    <figcaption>Drops, defenders and throw choices also affect this value. Individual uncertainty not estimated.</figcaption>
    <p class="counts" data-counts="cpoe"></p>
    <details class="pair-evidence" data-evidence="cpoe_pp"><summary>Values and included throws</summary><div class="table-scroll" role="region" aria-label="Selected completions above expectation records" tabindex="0"><table><caption>Percentage points on the same included throws used for completion rate.</caption><thead><tr><th scope="col">Quarterback</th><th scope="col">CPOE (pp)</th><th scope="col">Included throws</th></tr></thead><tbody data-selected-values></tbody></table></div></details>
   </figure>
  </div>
  <p class="scale-note"><span data-pair-legend></span> Each stat keeps its own fixed scale across all 560 qualifying annual records. Zero means matching the model's completion expectation for CPOE, or no modeled net gain for EPA.</p>
  <details class="optional-sacks" data-sack-section><summary>How often did they avoid sacks?</summary>
   <figure class="fan-comparison" aria-labelledby="nfl-sack-heading"><h2 id="nfl-sack-heading"><DefinitionHelp id="nfl-sack-avoidance" label="Dropbacks without a sack" detailTarget="nfl-definition-sack-avoidance" detailLabel="Formula and limits">The percentage of recorded dropbacks that did not end in a recorded sack.</DefinitionHelp></h2>
    <p>The percentage of recorded dropbacks that did not end in a recorded sack. Protection and receiver availability matter.</p><p class="unit">Percent of recorded dropbacks</p>
    <div data-chart-host><svg id="nfl-sack-plot" data-field="sack_avoidance_pct" hidden role="img" aria-labelledby="nfl-sack-plot-title nfl-sack-plot-description"></svg></div><figcaption>Individual uncertainty not estimated. Interceptions, incompletions and low-value escapes can count as avoiding a sack.</figcaption>
    <details class="pair-evidence" data-evidence="sack_avoidance_pct"><summary>Values, sacks and dropbacks</summary><div class="table-scroll" role="region" aria-label="Selected sack avoidance records" tabindex="0"><table><caption>Percent. The denominator is recorded dropbacks, not pressures or included throws.</caption><thead><tr><th scope="col">Quarterback</th><th scope="col">Without a sack (%)</th><th scope="col">Sacks / dropbacks</th></tr></thead><tbody data-selected-values></tbody></table></div></details>
   </figure>
  </details>

  </details>

  <details class="annual-records"><summary>All 560 annual records · works without JavaScript</summary>
   <p>Each year qualifies independently with at least 200 included throws in ten games. These are recorded passers, not a position-certified list. No eligible record means unavailable, not zero. 2011 is source blocked. Individual completion and sack ranges were not estimated.</p>
   <div class="table-scroll" role="region" aria-label="All 560 annual player-season records" tabindex="0"><table data-all-annual><caption>2006–2025 regular seasons excluding source-blocked 2011. Values use display rounding; downloads retain source precision.</caption><thead><tr><th scope="col">Player / season</th><th scope="col">Included throws / games</th><th scope="col">Whole CPOE (pp)</th><th scope="col">Completion (%)</th><th scope="col">Sacks / dropbacks</th><th scope="col">Without a sack (%)</th><th scope="col">EPA / dropback</th><th scope="col">EPA range / status</th></tr></thead><tbody>{annual.rows.map(r=><tr><th scope="row">{r.display_name}<br/>{r.season}</th><td>{r.eligible_throws} throws / {r.eligible_games} games</td><td>{fmt(r.cpoe_pp)}</td><td>{fmt(r.completion_pct)}</td><td>{r.sacks} sacks / {r.dropbacks} dropbacks in {r.dropback_games} games</td><td>{fmt(r.sack_avoidance_pct,1)}</td><td>{fmt(r.epa_per_dropback)}</td><td>{fmt(r.epa_lower)} to {fmt(r.epa_upper)}; {r.epa_interval_status.replaceAll('_',' ')}</td></tr>)}</tbody></table></div>
  </details>
  <details class="research-depth"><summary>Original 2023/2024 fixed-cohort evidence and study results</summary>
    <details class="complete-table"><summary>All 40 player-season records · works without JavaScript</summary>
      <p>CPOE uses percentage points (pp); completion and sack avoidance use percent. D means recorded dropbacks; O combines D with recorded non-scramble runs. EPA means expected points added. Intervals are marginal conditional sensitivities, not tests of differences. Values below use display rounding; the downloadable data retain source precision.</p>
      <div class="table-scroll" role="region" aria-label="All 40 player-season records" tabindex="0">
        <table data-all-players><caption>Original fixed 20-ID cohort, 2023 and 2024; separate from the new 560 annual records. Each metric cell names its denominator and uncertainty status.</caption>
          <thead><tr><th scope="col">Passer / season</th><th scope="col">CPOE (pp)</th><th scope="col">Completion (%)</th><th scope="col">EPA / D</th><th scope="col">Sack avoidance (%)</th><th scope="col">Scramble EPA / O</th><th scope="col">Non-scramble EPA / O</th><th scope="col">Scramble usage / diagnostic</th><th scope="col">Non-scramble usage / diagnostic</th></tr></thead>
          <tbody>{data.rows.map(r=><tr><th scope="row">{nameOf(r)}<br/>{r.season}<br/><small>{r.player_key}</small></th>
            {['cpoe_pp','completion_pct','epa_per_dropback','sack_avoidance_pct','scramble_contribution','nonscramble_contribution'].map(f=><td><strong>{fmt(r[f])}</strong><br/>{evidence(r,f)}<br/><small>{interval(r,f)}</small></td>)}
            {['scramble','nonscramble'].map(tag=><td>{r[`${tag}_runs`]} runs in {r[`${tag}_games`]} games<br/>{fmt(r[`${tag}_share_pct`])}% of {r.combined_opportunities} O in {r.combined_games} games<br/>{fmt(r[`${tag}_epa_per_run`])} EPA / role run<br/><small>{String(r[`${tag}_role_mean_status`]).replaceAll('_',' ')}; no share/per-run intervals</small></td>)}
          </tr>)}</tbody>
        </table>
      </div>
    </details>
    <details class="complete-table"><summary>All 10 study rows · works without JavaScript</summary>
      <div class="table-scroll" role="region" aria-label="All ten study associations" tabindex="0"><table data-all-studies>
        <caption>Approximate 95% conditional working-model sensitivities. Annual CPOE uses full-estimate centering; sack/run studies center each season on its own replicate mean. Games are deletion/sampling units. Annual strata contain 223 + 208 games where reported; these are not 431 independent quarterback pairs. Approximate game independence remains a working assumption.</caption>
        <thead><tr><th scope="col">Study</th><th scope="col">Estimate</th><th scope="col">Interval</th><th scope="col">Passers / contributing games</th><th scope="col">Status / influence</th></tr></thead>
        <tbody>{data.study_associations.map(s=><tr><th scope="row">{studyLabel(s)}</th><td>{fmt(s.estimate)}</td><td>{fmt(s.lower)} to {fmt(s.upper)}</td><td>{s.cohort_count} passers; {s.contributing_games ?? 'game count not in base export'}</td><td>{s.status.replaceAll('_',' ')}{s.point_status && <span>; point: {s.point_status}</span>}{s.influence && <p>Game-deletion r: {fmt(s.influence.game_deletion_min)} to {fmt(s.influence.game_deletion_max)} ({s.influence.game_undefined} undefined). Passer-deletion r: {fmt(s.influence.actor_deletion_min)} to {fmt(s.influence.actor_deletion_max)} ({s.influence.actor_undefined} undefined; {s.influence.actor_sign_reversals} sign reversals).</p>}</td></tr>)}</tbody>
      </table></div>
    </details>

  </details>
  <noscript><p>Interactive player selection and selected depth values require JavaScript. All 560 annual records, the original 40-record cohort and ten study results remain available above. Depth values are also available in the data download; no unavailable player-year is replaced.</p></noscript>
  <p class="download"><a href={ANNUAL_URL} download>Annual data</a> · <a href={ANNUAL_MANIFEST_URL}>Annual manifest</a> · <a href={DEPTH_URL} download>Depth data</a> · <a href={DEPTH_MANIFEST_URL}>Depth manifest</a><br/><a href={DATA_URL} download>Original 2023/2024 cohort data</a> · <a href={MANIFEST_URL}>Original manifest</a></p>
 </section>
</nfl-comparison>
