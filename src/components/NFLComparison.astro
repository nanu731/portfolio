---
const quantities = [
  ['CPOE', 'Percentage points', 'Individual uncertainty not estimated.'],
  ['Completion percentage', 'Percent', 'Individual uncertainty not estimated.'],
  ['Recorded-dropback EPA', 'Expected points per dropback', 'Marginal conditional interval.'],
  ['Recorded sack avoidance', 'Percent of dropbacks', 'Individual uncertainty not estimated.'],
  ['Recorded scramble contribution', 'Expected points per combined opportunity', 'Combines frequency and shared value.'],
  ['Recorded non-scramble run contribution', 'Expected points per combined opportunity', 'Recorded runs include aborted and lateral plays.'],
  ['Eligible throws', 'Throws', 'Same-row denominator for CPOE and completion.'],
  ['Recorded dropbacks', 'Dropbacks', 'A different opportunity population from eligible throws.'],
];
---
<nfl-comparison>
  <section aria-labelledby="nfl-comparison-heading">
    <h2 id="nfl-comparison-heading">Compare quarterbacks</h2>
    <p id="nfl-availability" class="availability" role="status" aria-live="polite">Player comparisons are unavailable while the reviewed dataset is being prepared. No player values are shown.</p>
    <div class="player-controls" aria-describedby="nfl-availability">
      <label for="nfl-player-a">QB A
        <select id="nfl-player-a" disabled><option value="">Player data unavailable</option></select>
      </label>
      <label for="nfl-player-b">QB B
        <select id="nfl-player-b" disabled><option value="">Player data unavailable</option></select>
      </label>
    </div>
    <div class="shared-controls">
      <label for="nfl-season">Season
        <select id="nfl-season" data-season><option value="2023">2023</option><option value="2024">2024</option></select>
      </label>
      <label for="nfl-view">View
        <select id="nfl-view" data-view>
          <option value="compare">Player comparison</option>
          <option value="association">Paired-season association</option>
          <option value="change">Two-season comparison</option>
          <option value="usage">Usage and contribution</option>
          <option value="composition">Recorded composition</option>
          <option value="study">Study-level evidence</option>
        </select>
      </label>
      <label for="nfl-metric">Measure
        <select id="nfl-metric" data-metric>
          <option value="cpoe">CPOE</option><option value="completion">Completion percentage</option><option value="epa">Recorded-dropback EPA</option>
          <option value="avoidance">Recorded sack avoidance</option><option value="scramble">Recorded scramble contribution</option><option value="nonscramble">Recorded non-scramble run contribution</option>
          <option value="composition" hidden>Recorded opportunity composition</option><option value="study" hidden>Study-level associations</option>
        </select>
      </label>
    </div>
    <p class="control-note" data-control-note>Both players use the selected season and measure.</p>
    <figure class="comparison-figure" aria-labelledby="nfl-view-heading">
      <h3 id="nfl-view-heading" data-view-heading>Player comparison</h3>
      <p data-view-description>Compare two players in native units, with the relevant sample sizes and uncertainty status.</p>
      <div class="plot-unavailable">
        <p>Comparison unavailable</p>
        <p>Verified player data is required before a chart can be shown.</p>
      </div>
      <svg hidden data-plot viewBox="0 0 960 480" role="img" aria-labelledby="nfl-plot-title nfl-plot-description">
        <title id="nfl-plot-title">Player comparison</title>
        <desc id="nfl-plot-description">No data marks are rendered while verified player data is unavailable.</desc>
      </svg>
      <figcaption>Each measure will keep a fixed scale across the selected players and seasons. Unavailable values are never plotted as zero.</figcaption>
    </figure>
    <details open class="evidence-table">
      <summary>Values and evidence table</summary>
      <div class="table-scroll" role="region" aria-label="Quarterback comparison table" tabindex="0">
        <table>
          <caption>Player values are unavailable. Units and evidence requirements remain visible.</caption>
          <thead><tr><th scope="col">Quantity</th><th scope="col">QB A</th><th scope="col">QB B</th><th scope="col">Unit and evidence</th></tr></thead>
          <tbody>{quantities.map(([label, unit, evidence]) => <tr><th scope="row">{label}</th><td>Unavailable</td><td>Unavailable</td><td>{unit}. {evidence}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
    <section class="measurement-status" aria-labelledby="nfl-measurement-status">
      <h3 id="nfl-measurement-status">Measurement status</h3>
      <dl>
        <div><dt>Arm strength</dt><dd>Unmeasured</dd></div>
        <div><dt>Processing</dt><dd>Unmeasured</dd></div>
        <div><dt>Recorded rushing contribution</dt><dd>Awaiting a reviewed comparison export</dd></div>
        <div><dt>Recorded sack avoidance</dt><dd>Awaiting a reviewed comparison export</dd></div>
      </dl>
      <p>Observed proxies do not fill every skill category. No overall rating or radar score is supplied.</p>
    </section>
    <noscript>JavaScript is required to switch views. The evidence table remains available.</noscript>
  </section>
</nfl-comparison>
<script>
  type View = 'compare' | 'association' | 'change' | 'usage' | 'composition' | 'study';
  const views: Record<View, {title: string; description: string; metrics: string[]; annual: boolean}> = {
    compare: {title: 'Player comparison', description: 'Compare two players in native units, with the relevant sample sizes and uncertainty status.', metrics: ['cpoe','epa','avoidance','scramble','nonscramble','completion'], annual: false},
    association: {title: 'Paired-season association', description: 'Locate the selected players among the fixed cohort across 2023 and 2024. Association describes alignment, not a forecast.', metrics: ['cpoe','completion','avoidance','scramble','nonscramble'], annual: true},
    change: {title: 'Two-season comparison', description: 'Inspect two historical points for each selected player. A difference between seasons does not establish development or a causal effect.', metrics: ['cpoe','epa','avoidance','scramble','nonscramble','completion'], annual: true},
    usage: {title: 'Usage and contribution', description: 'Inspect recorded role frequency beside shared EPA contribution per combined opportunity. Their mechanical frequency/value linkage does not measure athletic ability.', metrics: ['scramble','nonscramble'], annual: false},
    composition: {title: 'Recorded composition', description: 'Distinguish other recorded passes, sacks, scrambles and non-scramble actor runs within the combined opportunity population. Overlapping outcomes are not stacked.', metrics: ['composition'], annual: false},
    study: {title: 'Study-level evidence', description: 'Inspect the fixed study associations, their conditional intervals and the separate CPOE/completion difference. These intervals belong to the studies, not individual players.', metrics: ['study'], annual: true},
  };
  class NFLComparison extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';
      this.querySelectorAll<HTMLSelectElement>('[data-view],[data-metric],[data-season]').forEach(control => control.addEventListener('change', () => this.update()));
      this.update();
    }
    update() {
      const view = this.querySelector<HTMLSelectElement>('[data-view]')!;
      const metric = this.querySelector<HTMLSelectElement>('[data-metric]')!;
      const season = this.querySelector<HTMLSelectElement>('[data-season]')!;
      const selected = views[view.value as View];
      if (!selected) return;
      for (const option of metric.options) { option.hidden = !selected.metrics.includes(option.value); option.disabled = option.hidden; }
      if (!selected.metrics.includes(metric.value)) metric.value = selected.metrics[0];
      metric.disabled = selected.metrics.length === 1;
      season.disabled = selected.annual;
      this.querySelector('[data-view-heading]')!.textContent = selected.title;
      this.querySelector('[data-view-description]')!.textContent = selected.description;
      this.querySelector('#nfl-plot-title')!.textContent = selected.title;
      this.querySelector('[data-control-note]')!.textContent = selected.annual ? 'This view uses both 2023 and 2024. The single-season selector does not apply.' : 'Both players use the selected season and measure.';
      this.querySelector('[role="status"]')!.textContent = `${selected.title}: player comparisons are unavailable while the reviewed dataset is being prepared. No player values are shown.`;
    }
  }
  if (!customElements.get('nfl-comparison')) customElements.define('nfl-comparison', NFLComparison);
</script>
<style>
  nfl-comparison { display: block; margin-block: var(--space-l); }
  h2 { margin-block: 0 var(--space-s); }
  h3 { margin-block: 0 var(--space-s); }
  p { max-width: 65ch; }
  .availability { padding-block: var(--space-s); border-block: var(--rule) solid var(--green); }
  .player-controls, .shared-controls { display: grid; gap: var(--space-s); margin-block: var(--space-m); }
  label { display: grid; gap: var(--space-2xs); min-width: 0; }
  select { width: 100%; min-height: 44px; min-width: 0; padding: var(--space-2xs); font: inherit; color: var(--green); background: var(--cream); border: var(--rule) solid var(--green); }
  select:disabled { opacity: 1; color: var(--green); border-style: dashed; cursor: not-allowed; }
  :is(select, summary, .table-scroll):focus-visible { outline: var(--rule-thick) solid var(--accent); outline-offset: var(--space-3xs); }
  .control-note, figcaption, caption { font-size: var(--type-small); }
  .comparison-figure { margin: var(--space-l) 0; }
  .plot-unavailable { background: var(--sand); padding: var(--space-m); min-height: 10rem; display: grid; align-content: center; border: var(--rule-thin) solid var(--green); }
  .plot-unavailable p { margin-block: 0 var(--space-2xs); }
  .plot-unavailable p:first-child { font-family: var(--font-display); font-size: var(--type-h3); }
  svg { width: 100%; height: auto; }
  svg[hidden] { display: none; }
  figcaption { margin-top: var(--space-s); max-width: 65ch; }
  .evidence-table { border-block: var(--rule) solid var(--green); padding-block: var(--space-s); }
  summary { cursor: pointer; min-height: 44px; }
  .table-scroll { overflow-x: auto; scrollbar-color: var(--green) var(--cream); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  caption { text-align: left; padding-block: var(--space-s); }
  th, td { text-align: left; vertical-align: top; padding: var(--space-2xs); border-bottom: var(--rule-thin) solid var(--green); }
  th { font-weight: 600; }
  td { overflow-wrap: anywhere; }
  .measurement-status { margin-top: var(--space-l); }
  dl { margin: 0; }
  dl > div { display: grid; gap: var(--space-3xs); padding-block: var(--space-s); border-bottom: var(--rule-thin) solid var(--green); }
  dt { font-weight: 600; }
  dd { margin: 0; }
  @media(min-width: 40rem) { .player-controls { grid-template-columns: repeat(2,minmax(0,1fr)); } .shared-controls { grid-template-columns: minmax(6rem,1fr) minmax(0,2fr) minmax(0,2fr); } dl > div { grid-template-columns: 1fr 2fr; gap: var(--space-m); } }
</style>
