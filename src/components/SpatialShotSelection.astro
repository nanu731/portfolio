---
import DefinitionHelp from './DefinitionHelp.astro';
// The browser fetches the compact player index once, then one player payload per
// selection. Keeping the data in public/ lets Netlify cache each versioned file
// separately and keeps the versioned export out of Astro's JavaScript graph.
---

<spatial-shot-explorer data-base-path="/data/spatial-shot-selection/v4">
	<figure class="figure spatial-explorer" aria-label="Shot selection explorer">

		<div class="player-controls" aria-describedby="player-status">
			<div class="control season-control">
				<label class="label" for="season-select">Season</label>
				<select id="season-select" disabled data-season-select>
					<option value="2025-26" selected>2025–26</option>
					<option value="2024-25">2024–25</option>
					<option value="2023-24">2023–24</option>
					<option value="2022-23">2022–23</option>
					<option value="2021-22">2021–22</option>
				</select>
			</div>
			<div class="control player-combobox">
				<label class="label" for="player-search">Search player</label>
				<p class="search-help" id="search-help">Open the list or type a name. Accents and punctuation are optional.</p>
				<div class="combobox-shell" data-combobox-shell>
					<input
						type="search"
						id="player-search"
						placeholder="Search players in 2025–26"
						autocomplete="off"
						role="combobox"
						aria-autocomplete="list"
						aria-expanded="false"
						aria-controls="player-suggestions"
						aria-describedby="player-status search-help"
						disabled
						data-player-search
					/>
					<div
						id="player-suggestions"
						class="suggestion-menu"
						role="listbox"
						aria-label="Players in 2025–26"
						hidden
						data-player-suggestions
					></div>
				</div>
			</div>
		</div>

		<div class="status-row">
			<p id="player-status" class="status" role="status" aria-live="polite" data-status>
				Loading seasons and players…
			</p>
			<button type="button" class="retry" hidden data-retry>Try again</button>
		</div>

		<div class="plot explorer-plot" aria-busy="true" data-explorer-stage>
			<aside class="result-panel controls-panel" aria-label="Court controls">
				<fieldset class="view-controls" hidden data-view-controls>
					<legend class="guide-step"><span>1</span> Choose what to see</legend>
					<div class="view-options">
						<label><input type="radio" name="court-view" value="combined" checked /> Shot locations</label>
						<label><input type="radio" name="court-view" value="ability" /> Make-chance map</label>
					</div>
				</fieldset>
				<h3 class="guide-step"><span>2</span> Set the change</h3>
				<div class="result-empty" data-result-empty>
					<p>Choose a player</p>
				</div>

				<div hidden data-qualified-result>
					<div class="evidence-note label" hidden data-evidence-note><DefinitionHelp id="one-area" detailTarget="definition-one-area" detailLabel="See full definition" label="Estimate from One Area">One area passes the evidence rules for receiving moved shots. It cannot receive more shots once it reaches half the player’s total attempts.</DefinitionHelp></div>
					<div class="slider-block">
						<div class="slider-label">
							<label class="label" for="relocation-share">Shots to Move</label>
							<DefinitionHelp id="shots-to-move" detailTarget="definition-shots-to-move" detailLabel="See full definition" label="Shots to Move" compact>Your 0% setting allows up to 0 of every 100 shots to move. The amount moved can be lower because suitable shots or room in receiving areas can run out.</DefinitionHelp>
							<output class="numeric" for="relocation-share" data-slider-output>Up to 0%</output>
						</div>
						<p class="measure-note" id="slider-help">Choose the largest share of shots you want to move, from 0% to 25%.</p>
						<input type="range" id="relocation-share" min="0" max="25" step="5" value="0" disabled data-slider aria-describedby="slider-help" />
						<div class="slider-ends label numeric" aria-hidden="true"><span>0%</span><span>25%</span></div>
						<p class="actual-share numeric" data-actual-share></p>
						<p class="measure-note" data-moved-count></p>
						<p class="measure-note" hidden data-fraction-note>A faded cyan diamond represents the fraction of a shot at the movement boundary.</p>
						<p class="measure-note" hidden data-cap-note></p>
					</div>

				</div>
				<div class="insufficient" hidden data-insufficient-result>
					<h4 data-unavailable-title>No Clear Area for Moving Shots</h4>
					<p data-unavailable-copy></p>
				</div>
				<div class="insufficient" hidden data-season-unavailable>
					<h4 data-season-unavailable-title>Analysis unavailable</h4>
					<p data-season-unavailable-copy></p>
					<button type="button" class="retry reset-default" data-reset-default>Reset to LeBron James, 2025–26</button>
				</div>
			</aside>
			<div class="court-panel">
				<h3 class="guide-step"><span>3</span> Read the court</h3>
				<div class="court-title-row">
					<div>
						<p class="label" data-court-mode-label>Player chart</p>
						<h3 data-player-name>Choose a player</h3>
					</div>
					<p class="label numeric" data-season>2025–26</p>
				</div>

				<p class="court-guide" data-shot-guide>Recorded shots at 0%: green circles show makes; rust crosses show misses.</p>
				<div class="map-help" hidden data-map-help>
					<DefinitionHelp id="shooting-map" detailTarget="method-shooting-chances" detailLabel="See how the model works" label="Make-chance map">Each color shows the estimated chance of making a shot in that area. Outlined diamonds mark areas that pass the rules for receiving moved shots.</DefinitionHelp>
					<p>Darker blocks mean a higher estimated chance of a make. Outlined diamonds mark evidence for relocation; shot value also matters.</p>
					<p>The slider changes the scoring estimate, not this map. The fixed scale below applies to every player and season.</p>
				</div>

				<svg
					class="court"
					viewBox="0 0 500 450"
					role="img"
					tabindex="0"
					aria-labelledby="court-title court-description"
					aria-describedby="cell-detail"
					data-court
				>
					<title id="court-title" data-court-title>Choose a player</title>
					<desc id="court-description" data-court-description>
						Choose a player to see their shots.
					</desc>
					<g aria-hidden="true" data-heatmap-cells></g>
					<g aria-hidden="true" data-destination-markers></g>
					<g aria-hidden="true" data-shot-origins></g>
					<g aria-hidden="true" data-shot-dots></g>

					<!-- Court marks carry no data. Each gets a cream halo and green line so it
					     remains visible on every heatmap step. -->
					<g class="court-lines court-lines--halo" aria-hidden="true">
						<rect x="1" y="1" width="498" height="448"></rect>
						<path d="M30 450 L30 308 A237.5 237.5 0 0 1 470 308 L470 450"></path>
						<rect x="170" y="260" width="160" height="190"></rect>
						<circle cx="250" cy="260" r="60"></circle>
						<path d="M210 397.5 A40 40 0 0 0 290 397.5"></path>
						<line x1="220" y1="410" x2="280" y2="410"></line>
						<circle cx="250" cy="397.5" r="7.5"></circle>
					</g>
					<g class="court-lines court-lines--ink" aria-hidden="true">
						<rect x="1" y="1" width="498" height="448"></rect>
						<path d="M30 450 L30 308 A237.5 237.5 0 0 1 470 308 L470 450"></path>
						<rect x="170" y="260" width="160" height="190"></rect>
						<circle cx="250" cy="260" r="60"></circle>
						<path d="M210 397.5 A40 40 0 0 0 290 397.5"></path>
						<line x1="220" y1="410" x2="280" y2="410"></line>
						<circle cx="250" cy="397.5" r="7.5"></circle>
					</g>

					<g class="court-empty" data-court-empty>
						<rect x="105" y="188" width="290" height="74"></rect>
						<text x="250" y="232" text-anchor="middle">Choose a player</text>
					</g>
				</svg>

				<ul class="heat-legend" aria-label="Estimated chance of a make" data-heat-legend>
					<li><span class="swatch heat-1"></span><span class="numeric">Below 30%</span></li>
					<li><span class="swatch heat-2"></span><span class="numeric">30–40%</span></li>
					<li><span class="swatch heat-3"></span><span class="numeric">40–50%</span></li>
					<li><span class="swatch heat-4"></span><span class="numeric">50–60%</span></li>
					<li><span class="swatch heat-5"></span><span class="numeric">60% and above</span></li>
					<li class="destination-key">
						<span class="destination-symbol" aria-hidden="true"></span>
						<DefinitionHelp id="supported" detailTarget="method-receiving-areas" detailLabel="See how the model works" label="Area with Evidence for Moving Shots">The area has at least 10 recorded attempts and at least 90% model probability of beating the player’s past points per shot. An outlined diamond marks it; the 50% limit may leave no room to add shots.</DefinitionHelp>
					</li>
				</ul>

				<ul class="shot-legend" aria-label="Shot chart key" hidden data-shot-legend>
					<li><span class="shot-key shot-key--make" aria-hidden="true"></span><span>Made shot</span></li>
					<li><span class="shot-key shot-key--miss" aria-hidden="true">×</span><span>Missed shot</span></li>
					<li hidden data-relocation-key><span class="shot-key shot-key--moved" aria-hidden="true"></span><span>Moved shot</span></li>
					<li hidden data-relocation-key><span class="shot-key shot-key--origin" aria-hidden="true"></span><span>Original location</span></li>
				</ul>

				<p id="cell-detail" class="cell-detail numeric" aria-live="polite" data-cell-detail>
					Choose a player to see their shots.
				</p>
			</div>


			<div class="result-panel metrics-panel" hidden data-metrics-result>
					<div class="gain-grid">
						<div>
							<div class="label"><DefinitionHelp id="season-gain" detailTarget="formula-season-gain" detailLabel="See the formula" label="Extra Points in 2025–26">The model estimates 0 extra points over the same recorded shots. This compares possible shot mixes, not a future season forecast.</DefinitionHelp></div>
							<p class="gain-value numeric" data-season-gain></p>
							<div class="interval"><DefinitionHelp id="range" detailTarget="formula-range" detailLabel="See the formula" label="Estimated Range (90%)">This range covers the middle 90% of the model’s estimates. It does not include every uncertainty in a real game.</DefinitionHelp></div>
							<p class="interval numeric" data-season-interval></p>
							<p class="measure-note" data-season-note></p>
							<p class="measure-note">The middle 90% of estimates within this model. Real games can differ for reasons the model does not include.</p>
						</div>
						<div>
							<div class="label"><DefinitionHelp id="per-100" detailTarget="formula-per-100" detailLabel="See the formula" label="Extra Points per 100 Shots">The model estimates 0.0 extra points for every 100 attempts at this slider setting. This puts players with different shot counts on the same scale.</DefinitionHelp></div>
							<p class="gain-value numeric" data-per-100-gain></p>
							<p class="interval">Estimated Range (90%)</p>
							<p class="interval numeric" data-per-100-interval></p>
							<p class="measure-note">The estimated difference for every 100 attempts.</p>
						</div>
					</div>

					<div class="score-block">
						<div class="label"><DefinitionHelp id="score" detailTarget="formula-score" detailLabel="See the formula" label="Shot Selection Score">The score compares the past shot mix with the allowed scenario at the 25% request. Higher means less estimated room to improve; this is not a league rank or overall player rating.</DefinitionHelp></div>
						<p class="score numeric"><span data-score></span><span class="score-denominator"> / 100</span></p>
						<p class="interval">Estimated Range (90%)</p>
						<p class="interval numeric" data-score-interval></p>
						<p class="measure-note">Compares the past shot mix with the scenario that asks to move up to 25%. Higher means less estimated room to improve.</p>
						<p class="measure-note">This score is not a league ranking or a rating of the whole player. It stays fixed as you move the slider.</p>
					</div>
			</div>
				<p class="disclaimer">These estimates assume the player can get the new shots and keep the same shooting ability.
					They do not show that moving shots would cause extra points in a real game.
					The model leaves out defense, fatigue, passing, shot creation, shot-clock pressure, and game situation.</p>
		</div>

		<noscript>
			<p class="noscript">Turn on JavaScript to use the player search and shot charts. The explanations below remain available.</p>
		</noscript>

		<figcaption>
			<b class="label">Fig 1</b>
			<span data-caption-player>Choose a player.</span>
			<span data-caption-body>Choose a player.</span>
		</figcaption>
	</figure>
</spatial-shot-explorer>

<script>
	type EvidenceStatus =
		| 'insufficient_evidence'
		| 'single_destination'
		| 'multiple_destinations';
	type AvailabilityReason =
		| 'available'
		| 'no_supported_destinations'
		| 'no_positive_supported_capacity'
		| 'no_eligible_weak_source_mass';

	type PlayerIndexEntry = {
		player_id: string;
		player_name: string;
		player_file: string;
		evidence_status: EvidenceStatus;
		supported_destination_count: number;
		relocation_available: boolean;
		availability_reason: AvailabilityReason;
		score_available: boolean;
	};
	type SeasonId = '2025-26' | '2024-25' | '2023-24' | '2022-23' | '2021-22';
	type AvailabilityStatus =
		| 'no_recorded_shots'
		| 'model_ineligible'
		| 'insufficient_evidence'
		| 'single_destination'
		| 'multiple_destinations';
	type SeasonManifestEntry = {
		season: SeasonId;
		player_index: string;
		player_count: number;
	};
	type PlayerSeasonAvailability = {
		season: SeasonId;
		analysis_available: boolean;
		availability_status: AvailabilityStatus;
		availability_reason: string;
		recorded_shots: number;
		in_play_shots: number;
		in_play_games: number;
	};
	type PlayerCatalogEntry = {
		player_id: string;
		player_name: string;
		seasons: PlayerSeasonAvailability[];
	};

	type HeatmapCell = {
		cell_id: number;
		x_min_ft: number;
		x_max_ft: number;
		y_min_ft: number;
		y_max_ft: number;
		modeled_make_probability: number;
		make_probability_lower_90: number;
		make_probability_upper_90: number;
		observed_attempts: number;
		supported_destination: boolean;
	};

	type SliderResult = {
		requested_share: number;
		actual_relocated_share: number;
		actual_relocated_attempt_equivalents: number;
		relocated_expected_points_per_attempt: PosteriorSummary;
		season_gain: PosteriorSummary;
		gain_per_100: PosteriorSummary;
	};

	type PosteriorSummary = {
		mean: number | null;
		lower_90: number | null;
		upper_90: number | null;
	};

	type Shot = {
		x_ft: number;
		y_ft: number;
		made: boolean;
		move_order: number | null;
		after_x_ft: number | null;
		after_y_ft: number | null;
	};

	type PlayerPayload = {
		schema_version: string;
		data_version: string;
		method_id: string;
		season: string;
		player_id: string;
		player_name: string;
		evidence_status: EvidenceStatus;
		relocation_available: boolean;
		availability_reason: AvailabilityReason;
		score_available: boolean;
		observed_attempts: number;
		makes: number;
		misses: number;
		source_cell_count: number;
		eligible_source_share: number;
		supported_destination_count: number;
		score: {
			point: number | null;
			lower_90: number | null;
			upper_90: number | null;
		};
		sliders: SliderResult[];
		heatmap_cells: HeatmapCell[];
		shots: Shot[];
	};

	type CourtView = 'combined' | 'ability';

	const SVG_NS = 'http://www.w3.org/2000/svg';
	const ROOT_SCHEMA = '4.0.0';
	const ROOT_DATA = 'five-season-targeted-v4';
	const EXPECTED_METHOD = 'car-targeted-capped-weak-location-relocation-v3';
	const PRELOAD_PLAYER_ID = '2544';
	const DEFAULT_SEASON: SeasonId = '2025-26';
	const EXPECTED_SEASONS: ReadonlyArray<{
		season: SeasonId;
		playerCount: number;
		schemaVersion: string;
		dataVersion: string;
	}> = [
		{ season: '2025-26', playerCount: 318, schemaVersion: '3.0.0', dataVersion: '2025-26-targeted-v3' },
		{ season: '2024-25', playerCount: 304, schemaVersion: '4.0.0', dataVersion: '2024-25-targeted-v4' },
		{ season: '2023-24', playerCount: 281, schemaVersion: '4.0.0', dataVersion: '2023-24-targeted-v4' },
		{ season: '2022-23', playerCount: 292, schemaVersion: '4.0.0', dataVersion: '2022-23-targeted-v4' },
		{ season: '2021-22', playerCount: 312, schemaVersion: '4.0.0', dataVersion: '2021-22-targeted-v4' },
	];
	const EXPECTED_CELLS = 156;
	const EXPECTED_SLIDERS = [0, 0.05, 0.1, 0.15, 0.2, 0.25];
	const HEAT_COLOURS = [
		'var(--cream)',
		'var(--sand)',
		'var(--green-mid)',
		'var(--green-deep)',
		'var(--green)',
	] as const;

	const isRecord = (value: unknown): value is Record<string, unknown> =>
		typeof value === 'object' && value !== null;
	const isFiniteNumber = (value: unknown): value is number =>
		typeof value === 'number' && Number.isFinite(value);
	const requireElement = <T extends Element>(root: ParentNode, selector: string): T => {
		const element = root.querySelector<T>(selector);
		if (!element) throw new Error(`Spatial explorer is missing ${selector}`);
		return element;
	};
	const oneDecimal = (value: number) => value.toFixed(1);
	const whole = (value: number) => Math.round(value).toLocaleString('en-US');
	const signed = (value: number, digits: number) => {
		const rounded = digits === 0 ? whole(value) : oneDecimal(value);
		return value > 0 ? `+${rounded}` : rounded;
	};
	const probabilityPercent = (value: number) => `${oneDecimal(value * 100)}%`;
	const heatBin = (value: number) => {
		if (value < 0.3) return 0;
		if (value < 0.4) return 1;
		if (value < 0.5) return 2;
		if (value < 0.6) return 3;
		return 4;
	};
	const courtX = (feet: number) => (feet + 25) * 10;
	const courtY = (feet: number) => (39.75 - feet) * 10;
	const normalizeSearch = (value: string) =>
		value
			.normalize('NFD')
			.replace(/\p{M}/gu, '')
			.toLocaleLowerCase()
			.replace(/[\p{P}\p{S}]+/gu, ' ')
			.replace(/\s+/g, ' ')
			.trim();
	const compactSearch = (value: string) => normalizeSearch(value).replace(/\s/g, '');

	class SpatialShotExplorer extends HTMLElement {
		private players: PlayerIndexEntry[] = [];
		private catalog = new Map<string, PlayerCatalogEntry>();
		private seasons = new Map<SeasonId, SeasonManifestEntry>();
		private matches: PlayerIndexEntry[] = [];
		private activeSuggestionIndex = -1;
		private activeRequest?: AbortController;
		private requestVersion = 0;
		private selectedSeason: SeasonId = DEFAULT_SEASON;
		private deliberatePlayerId?: string;
		private currentPlayer?: PlayerPayload;
		private courtView: CourtView = 'combined';
		private activeCellIndex = 0;
		private retryAction?: () => void;
		private readonly handleOutsidePointer = (event: PointerEvent) => {
			if (event.target instanceof Node && !this.combobox.contains(event.target)) {
				this.closeSuggestions();
			}
		};

		connectedCallback() {
			if (this.dataset.initialized === 'true') return;
			this.dataset.initialized = 'true';

			this.search.addEventListener('input', () => this.updateSuggestions());
			this.search.addEventListener('focus', () => this.showAllSuggestions());
			this.search.addEventListener('keydown', (event) => this.handleSearchKeydown(event));
			this.seasonSelect.addEventListener('change', () => void this.changeSeason());
			document.addEventListener('pointerdown', this.handleOutsidePointer);
			this.slider.addEventListener('input', () => this.updateSlider());
			this.querySelectorAll<HTMLInputElement>('input[name="court-view"]').forEach((control) => {
				control.addEventListener('change', () => {
					if (control.checked) this.setCourtView(control.value as CourtView);
				});
			});
			this.retry.addEventListener('click', () => this.retryAction?.());
			this.resetDefault.addEventListener('click', () => void this.resetToDefault());
			this.court.addEventListener('focus', () => {
				if (this.courtView === 'ability') this.showCell(this.activeCellIndex);
			});
			this.court.addEventListener('keydown', (event) => this.moveCell(event));

			void this.loadCatalog();
		}

		private get basePath() {
			return this.dataset.basePath ?? '/data/spatial-shot-selection/v4';
		}

		private get seasonSelect() {
			return requireElement<HTMLSelectElement>(this, '[data-season-select]');
		}

		private get search() {
			return requireElement<HTMLInputElement>(this, '[data-player-search]');
		}
		private get combobox() {
			return requireElement<HTMLElement>(this, '[data-combobox-shell]');
		}
		private get suggestions() {
			return requireElement<HTMLElement>(this, '[data-player-suggestions]');
		}
		private get status() {
			return requireElement<HTMLElement>(this, '[data-status]');
		}
		private get retry() {
			return requireElement<HTMLButtonElement>(this, '[data-retry]');
		}
		private get stage() {
			return requireElement<HTMLElement>(this, '[data-explorer-stage]');
		}
		private get slider() {
			return requireElement<HTMLInputElement>(this, '[data-slider]');
		}
		private get court() {
			return requireElement<SVGSVGElement>(this, '[data-court]');
		}
		private get resetDefault() {
			return requireElement<HTMLButtonElement>(this, '[data-reset-default]');
		}

		private beginRequest() {
			this.activeRequest?.abort();
			const controller = new AbortController();
			this.activeRequest = controller;
			this.requestVersion += 1;
			return { controller, version: this.requestVersion };
		}

		private requestIsCurrent(controller: AbortController, version: number) {
			return controller === this.activeRequest && version === this.requestVersion;
		}

		private async fetchJson(path: string, signal?: AbortSignal): Promise<unknown> {
			const response = await fetch(path, { signal, headers: { Accept: 'application/json' } });
			if (!response.ok) throw new Error(`Request returned ${response.status}`);
			return response.json();
		}

		private validateManifest(value: unknown): SeasonManifestEntry[] {
			if (
				!isRecord(value) ||
				value.schema_version !== ROOT_SCHEMA ||
				value.data_version !== ROOT_DATA ||
				value.player_availability_catalog !== 'players.json' ||
				!Array.isArray(value.seasons) ||
				value.seasons.length !== EXPECTED_SEASONS.length
			) {
				throw new Error('Season manifest does not match this explorer');
			}

			return value.seasons.map((raw, index) => {
				const expected = EXPECTED_SEASONS[index];
				if (
					!isRecord(raw) ||
					raw.season !== expected.season ||
					raw.player_index !== `seasons/${expected.season}/players.json` ||
					raw.player_count !== expected.playerCount
				) {
					throw new Error('Season manifest contains an invalid season');
				}
				return {
					season: expected.season,
					player_index: raw.player_index,
					player_count: raw.player_count,
				};
			});
		}

		private validateCatalog(value: unknown): PlayerCatalogEntry[] {
			if (
				!isRecord(value) ||
				value.schema_version !== ROOT_SCHEMA ||
				value.data_version !== ROOT_DATA ||
				!Array.isArray(value.players) ||
				value.players.length !== 1017
			) {
				throw new Error('Player availability catalog does not match this explorer');
			}
			const seen = new Set<string>();
			return value.players.map((raw) => {
				if (
					!isRecord(raw) ||
					typeof raw.player_id !== 'string' ||
					typeof raw.player_name !== 'string' ||
					seen.has(raw.player_id) ||
					!Array.isArray(raw.seasons) ||
					raw.seasons.length !== EXPECTED_SEASONS.length
				) {
					throw new Error('Player availability catalog contains an invalid player');
				}
				seen.add(raw.player_id);
				const seasons = raw.seasons.map((seasonRaw, index) => {
					const expected = EXPECTED_SEASONS[index];
					if (!isRecord(seasonRaw)) {
						throw new Error('Player availability catalog contains an invalid season');
					}
					const status = seasonRaw.availability_status;
					const statusIsValid = [
						'no_recorded_shots',
						'model_ineligible',
						'insufficient_evidence',
						'single_destination',
						'multiple_destinations',
					].includes(String(status));
					if (
						seasonRaw.season !== expected.season ||
						!statusIsValid ||
						typeof seasonRaw.availability_reason !== 'string' ||
						typeof seasonRaw.analysis_available !== 'boolean' ||
						!Number.isInteger(seasonRaw.recorded_shots) ||
						!Number.isInteger(seasonRaw.in_play_shots) ||
						!Number.isInteger(seasonRaw.in_play_games) ||
						seasonRaw.recorded_shots < 0 ||
						seasonRaw.in_play_shots < 0 ||
						seasonRaw.in_play_games < 0 ||
						seasonRaw.analysis_available === ['no_recorded_shots', 'model_ineligible'].includes(String(status))
					) {
						throw new Error('Player availability catalog contains an invalid status');
					}
					return {
						season: expected.season,
						analysis_available: seasonRaw.analysis_available,
						availability_status: status as AvailabilityStatus,
						availability_reason: seasonRaw.availability_reason,
						recorded_shots: seasonRaw.recorded_shots,
						in_play_shots: seasonRaw.in_play_shots,
						in_play_games: seasonRaw.in_play_games,
					};
				});
				return { player_id: raw.player_id, player_name: raw.player_name, seasons };
			});
		}

		private validateIndex(value: unknown, season: SeasonId): PlayerIndexEntry[] {
			if (!isRecord(value)) throw new Error('Player index is not an object');
			const expected = EXPECTED_SEASONS.find((item) => item.season === season);
			if (
				!expected ||
				value.schema_version !== expected.schemaVersion ||
				value.data_version !== expected.dataVersion ||
				value.season !== season
			) {
				throw new Error('Player index version does not match this explorer');
			}
			if (!Array.isArray(value.players) || value.players.length !== expected.playerCount) {
				throw new Error(`Expected ${expected.playerCount} players`);
			}

			const seen = new Set<string>();
			return value.players.map((raw) => {
				if (!isRecord(raw)) throw new Error('Player index contains an invalid row');
				const player_id = raw.player_id;
				const player_name = raw.player_name;
				const player_file = raw.player_file;
				const evidence_status = raw.evidence_status;
				const availability_reason = raw.availability_reason;
				if (
					typeof player_id !== 'string' ||
					typeof player_name !== 'string' ||
					typeof player_file !== 'string' ||
					!/^players\/\d+\.json$/.test(player_file) ||
					(evidence_status !== 'insufficient_evidence' &&
						evidence_status !== 'single_destination' &&
						evidence_status !== 'multiple_destinations') ||
					!isFiniteNumber(raw.supported_destination_count) ||
					!Number.isInteger(raw.supported_destination_count) ||
					raw.supported_destination_count < 0 ||
					(evidence_status === 'insufficient_evidence' && raw.supported_destination_count !== 0) ||
					(evidence_status === 'single_destination' && raw.supported_destination_count !== 1) ||
					(evidence_status === 'multiple_destinations' && raw.supported_destination_count < 2) ||
					!['available', 'no_supported_destinations', 'no_positive_supported_capacity',
						'no_eligible_weak_source_mass'].includes(String(availability_reason)) ||
					typeof raw.relocation_available !== 'boolean' ||
					typeof raw.score_available !== 'boolean' ||
					raw.relocation_available !== raw.score_available ||
					(raw.relocation_available && availability_reason !== 'available') ||
					(!raw.relocation_available && availability_reason === 'available') ||
					seen.has(player_id)
				) {
					throw new Error('Player index contains an invalid identity or path');
				}
				seen.add(player_id);
				return {
					player_id,
					player_name,
					player_file,
					evidence_status,
					supported_destination_count: raw.supported_destination_count as number,
					relocation_available: raw.relocation_available,
					availability_reason: availability_reason as AvailabilityReason,
					score_available: raw.score_available,
				};
			});
		}

		private validatePlayer(value: unknown, entry: PlayerIndexEntry, season: SeasonId): PlayerPayload {
			if (!isRecord(value)) throw new Error('Player payload is not an object');
			const expected = EXPECTED_SEASONS.find((item) => item.season === season);
			if (
				!expected ||
				value.schema_version !== expected.schemaVersion ||
				value.data_version !== expected.dataVersion ||
				value.method_id !== EXPECTED_METHOD ||
				value.season !== season ||
				value.player_id !== entry.player_id ||
				value.player_name !== entry.player_name ||
				value.evidence_status !== entry.evidence_status ||
				value.availability_reason !== entry.availability_reason ||
				value.supported_destination_count !== entry.supported_destination_count ||
				value.score_available !== entry.score_available ||
				value.relocation_available !== entry.relocation_available ||
				!isFiniteNumber(value.observed_attempts) ||
				!isFiniteNumber(value.makes) ||
				!isFiniteNumber(value.misses) ||
				value.makes + value.misses !== value.observed_attempts ||
				!isRecord(value.score) ||
				!Array.isArray(value.sliders) ||
				!Array.isArray(value.heatmap_cells) ||
				!Array.isArray(value.shots) ||
				value.heatmap_cells.length !== EXPECTED_CELLS ||
				value.sliders.length !== EXPECTED_SLIDERS.length ||
				value.shots.length !== value.observed_attempts
			) {
				throw new Error('Player payload does not match the versioned contract');
			}

			value.heatmap_cells.forEach((raw) => {
				if (
					!isRecord(raw) ||
					!isFiniteNumber(raw.cell_id) ||
					!isFiniteNumber(raw.x_min_ft) ||
					!isFiniteNumber(raw.x_max_ft) ||
					!isFiniteNumber(raw.y_min_ft) ||
					!isFiniteNumber(raw.y_max_ft) ||
					!isFiniteNumber(raw.modeled_make_probability) ||
					!isFiniteNumber(raw.make_probability_lower_90) ||
					!isFiniteNumber(raw.make_probability_upper_90) ||
					!isFiniteNumber(raw.observed_attempts) ||
					typeof raw.supported_destination !== 'boolean' ||
					raw.modeled_make_probability < 0 ||
					raw.modeled_make_probability > 1
				) {
					throw new Error('Player payload contains an invalid heatmap cell');
				}
			});

			value.sliders.forEach((raw, index) => {
				if (
					!isRecord(raw) ||
					!isFiniteNumber(raw.requested_share) ||
					!isFiniteNumber(raw.actual_relocated_share) ||
					!isFiniteNumber(raw.actual_relocated_attempt_equivalents) ||
					!isRecord(raw.relocated_expected_points_per_attempt) ||
					!isRecord(raw.season_gain) ||
					!isRecord(raw.gain_per_100)
				) {
					throw new Error('Player payload contains an invalid slider row');
				}
				if (
					Math.abs(raw.requested_share - EXPECTED_SLIDERS[index]) > 1e-9 ||
					raw.actual_relocated_share > raw.requested_share + 1e-9
				) {
					throw new Error('Player payload slider values are out of order');
				}
			});

			const moveOrders: number[] = [];
			value.shots.forEach((raw) => {
				if (
					!isRecord(raw) ||
					!isFiniteNumber(raw.x_ft) ||
					!isFiniteNumber(raw.y_ft) ||
					typeof raw.made !== 'boolean'
				) {
					throw new Error('Player payload contains an invalid shot');
				}
				if (raw.move_order === null) {
					if (raw.after_x_ft !== null || raw.after_y_ft !== null) {
						throw new Error('Unmoved shot contains an after location');
					}
				} else if (
					!Number.isInteger(raw.move_order) ||
					raw.move_order < 1 ||
					!isFiniteNumber(raw.after_x_ft) ||
					!isFiniteNumber(raw.after_y_ft)
				) {
					throw new Error('Moved shot row is invalid');
				} else {
					moveOrders.push(raw.move_order);
				}
			});
			moveOrders.sort((a, b) => a - b);
			if (!moveOrders.every((item, index) => item === index + 1)) {
				throw new Error('Player move order is not deterministic and nested');
			}

			const payload = value as unknown as PlayerPayload;
			const scoreValues = [payload.score.point, payload.score.lower_90, payload.score.upper_90];
			const gainValues = payload.sliders.flatMap((row) => [
				row.season_gain.mean,
				row.season_gain.lower_90,
				row.season_gain.upper_90,
				row.gain_per_100.mean,
				row.gain_per_100.lower_90,
				row.gain_per_100.upper_90,
			]);

			if (payload.relocation_available) {
				if (
					!payload.score_available ||
					![...scoreValues, ...gainValues].every(isFiniteNumber)
				) {
					throw new Error('Available player is missing a score or gain');
				}
			} else if (
				payload.score_available ||
				![...scoreValues, ...gainValues].every((item) => item === null)
			) {
				throw new Error('Unavailable player contains a published score or gain');
			}

			return payload;
		}

		private seasonLabel(season: SeasonId) {
			return season.replace('-', '–');
		}

		private catalogSeason(playerId: string, season: SeasonId) {
			return this.catalog.get(playerId)?.seasons.find((item) => item.season === season);
		}

		private async loadCatalog() {
			this.retry.hidden = true;
			this.retryAction = () => void this.loadCatalog();
			this.setStatus('Loading seasons and players…');
			try {
				const [manifestRaw, catalogRaw] = await Promise.all([
					this.fetchJson(`${this.basePath}/manifest.json`),
					this.fetchJson(`${this.basePath}/players.json`),
				]);
				this.seasons = new Map(
					this.validateManifest(manifestRaw).map((item) => [item.season, item]),
				);
				this.catalog = new Map(
					this.validateCatalog(catalogRaw).map((item) => [item.player_id, item]),
				);
				if (this.catalog.get(PRELOAD_PLAYER_ID)?.player_name !== 'LeBron James') {
					throw new Error('LeBron James is missing from the player catalog');
				}
				this.seasonSelect.disabled = false;
				await this.loadSeason(DEFAULT_SEASON, PRELOAD_PLAYER_ID);
			} catch (error) {
				this.showError('We couldn’t load the seasons and players. Check your connection and try again.');
			}
		}

		private async changeSeason() {
			const next = EXPECTED_SEASONS.find((item) => item.season === this.seasonSelect.value);
			if (!next) return;
			const playerId = this.deliberatePlayerId ?? PRELOAD_PLAYER_ID;
			await this.loadSeason(next.season, playerId);
		}

		private async resetToDefault() {
			this.deliberatePlayerId = undefined;
			this.seasonSelect.value = DEFAULT_SEASON;
			this.search.value = 'LeBron James';
			const resetVersion = this.requestVersion + 1;
			await this.loadSeason(DEFAULT_SEASON, PRELOAD_PLAYER_ID);
			if (this.requestVersion === resetVersion && this.currentPlayer?.player_id === PRELOAD_PLAYER_ID) {
				this.setStatus('Reset complete. LeBron James, 2025–26. Shot locations at 0%; no shots moved.');
			}
		}

		private async loadSeason(season: SeasonId, playerId: string) {
			const seasonManifest = this.seasons.get(season);
			if (!seasonManifest) throw new Error(`Season ${season} is missing from the manifest`);
			const request = this.beginRequest();
			const playerName = this.catalog.get(playerId)?.player_name ?? 'Selected player';
			this.selectedSeason = season;
			this.seasonSelect.value = season;
			this.suggestions.setAttribute('aria-label', `Players in ${this.seasonLabel(season)}`);
			this.search.disabled = true;
			this.closeSuggestions();
			this.retry.hidden = true;
			this.retryAction = () => void this.loadSeason(season, playerId);
			this.stage.setAttribute('aria-busy', 'true');
			requireElement<HTMLElement>(this, '[data-season]').textContent = this.seasonLabel(season);
			this.clearResult(playerName, `Loading ${this.seasonLabel(season)}…`);
			this.setStatus(`Loading ${this.seasonLabel(season)} players…`);

			try {
				const raw = await this.fetchJson(
					`${this.basePath}/${seasonManifest.player_index}`,
					request.controller.signal,
				);
				if (!this.requestIsCurrent(request.controller, request.version)) return;
				this.players = this.validateIndex(raw, season).sort((a, b) =>
					a.player_name.localeCompare(b.player_name, undefined, { sensitivity: 'base' }),
				);
				this.search.disabled = false;
				this.search.placeholder = `Search players in ${this.seasonLabel(season)}`;
				const entry = this.players.find((player) => player.player_id === playerId);
				if (entry) {
					this.search.value = entry.player_name;
					await this.loadPlayer(entry, request);
					return;
				}

				const availability = this.catalogSeason(playerId, season);
				if (!availability || availability.analysis_available) {
					throw new Error('Player availability does not match the season index');
				}
				this.search.value = playerName;
				this.showSeasonUnavailable(playerName, season, availability);
			} catch (error) {
				if (error instanceof DOMException && error.name === 'AbortError') return;
				if (!this.requestIsCurrent(request.controller, request.version)) return;
				this.showError(`We couldn’t load ${this.seasonLabel(season)}. Try again.`);
			}
		}

		private updateSuggestions() {
			const query = normalizeSearch(this.search.value);
			const compactQuery = compactSearch(this.search.value);

			this.matches = this.players
				.filter((player) => {
					const normalized = normalizeSearch(player.player_name);
					const compact = compactSearch(player.player_name);
					return normalized.includes(query) || compact.includes(compactQuery);
				})
				.sort((a, b) => {
					const aStarts =
						normalizeSearch(a.player_name).startsWith(query) ||
						compactSearch(a.player_name).startsWith(compactQuery);
					const bStarts =
						normalizeSearch(b.player_name).startsWith(query) ||
						compactSearch(b.player_name).startsWith(compactQuery);
					if (aStarts !== bStarts) return aStarts ? -1 : 1;
					return (
						a.player_name.localeCompare(b.player_name, undefined, { sensitivity: 'base' }) ||
						a.player_id.localeCompare(b.player_id)
					);
				});
			this.activeSuggestionIndex = -1;
			this.renderSuggestions();
			this.openSuggestions();
			this.setStatus(
				`${this.matches.length} ${this.matches.length === 1 ? 'player matches' : 'players match'} in ${this.seasonLabel(this.selectedSeason)}.`,
			);
		}

		private showAllSuggestions() {
			if (this.search.disabled || this.players.length === 0) return;
			this.matches = [...this.players];
			this.activeSuggestionIndex = -1;
			this.renderSuggestions();
			this.openSuggestions();
			this.setStatus(
				`${this.players.length} players in ${this.seasonLabel(this.selectedSeason)}. Type to narrow the list.`,
			);
		}

		private suggestionLabel(player: PlayerIndexEntry) {
			if (player.evidence_status === 'single_destination') {
				return `${player.player_name} (one area passes the evidence rules)`;
			}
			if (player.evidence_status === 'insufficient_evidence') {
				return `${player.player_name} (no clear area for moving shots)`;
			}
			return player.player_name;
		}

		private renderSuggestions() {
			const fragment = document.createDocumentFragment();
			if (this.matches.length === 0) {
				const empty = document.createElement('p');
				empty.className = 'no-results';
				empty.setAttribute('role', 'option');
				empty.setAttribute('aria-disabled', 'true');
				empty.setAttribute('aria-selected', 'false');
				empty.textContent = 'No players found. Try another name or season.';
				fragment.append(empty);
			} else {
				this.matches.forEach((player, index) => {
					const option = document.createElement('div');
					option.id = `player-option-${player.player_id}`;
					option.className = 'suggestion-option';
					option.setAttribute('role', 'option');
					option.setAttribute('aria-selected', String(index === this.activeSuggestionIndex));
					option.dataset.suggestionIndex = String(index);
					option.textContent = this.suggestionLabel(player);
					option.addEventListener('mousedown', (event) => event.preventDefault());
					option.addEventListener('click', () => this.selectSuggestion(player));
					fragment.append(option);
				});
			}
			this.suggestions.replaceChildren(fragment);
		}

		private openSuggestions() {
			this.suggestions.hidden = false;
			this.search.setAttribute('aria-expanded', 'true');
		}

		private closeSuggestions() {
			this.suggestions.hidden = true;
			this.matches = [];
			this.activeSuggestionIndex = -1;
			this.search.setAttribute('aria-expanded', 'false');
			this.search.removeAttribute('aria-activedescendant');
		}

		private moveSuggestion(step: -1 | 1) {
			if (this.matches.length === 0) return;
			this.activeSuggestionIndex =
				this.activeSuggestionIndex === -1
					? step === 1
						? 0
						: this.matches.length - 1
					: (this.activeSuggestionIndex + step + this.matches.length) % this.matches.length;
			this.renderSuggestions();
			const active = requireElement<HTMLElement>(
				this.suggestions,
				`[data-suggestion-index="${this.activeSuggestionIndex}"]`,
			);
			this.search.setAttribute('aria-activedescendant', active.id);
			active.scrollIntoView({ block: 'nearest' });
		}

		private handleSearchKeydown(event: KeyboardEvent) {
			if (event.key === 'Escape') {
				if (!this.suggestions.hidden) event.preventDefault();
				this.closeSuggestions();
				return;
			}

			if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
				event.preventDefault();
				if (this.suggestions.hidden) this.showAllSuggestions();
				this.moveSuggestion(event.key === 'ArrowDown' ? 1 : -1);
				return;
			}

			if (event.key === 'Enter' && this.activeSuggestionIndex >= 0) {
				event.preventDefault();
				const entry = this.matches[this.activeSuggestionIndex];
				if (entry) this.selectSuggestion(entry);
			}
		}

		private selectSuggestion(entry: PlayerIndexEntry) {
			this.deliberatePlayerId = entry.player_id;
			this.search.value = entry.player_name;
			this.closeSuggestions();
			void this.loadPlayer(entry);
		}

		private async loadPlayer(
			entry: PlayerIndexEntry,
			request = this.beginRequest(),
		) {
			const season = this.selectedSeason;
			this.retryAction = () => void this.loadPlayer(entry);
			this.retry.hidden = true;
			this.stage.setAttribute('aria-busy', 'true');
			this.clearResult(entry.player_name, 'Loading chart…');
			this.setStatus(`Loading ${entry.player_name}, ${this.seasonLabel(season)}…`);

			try {
				const raw = await this.fetchJson(
					`${this.basePath}/seasons/${season}/${entry.player_file}`,
					request.controller.signal,
				);
				if (!this.requestIsCurrent(request.controller, request.version)) return;
				const player = this.validatePlayer(raw, entry, season);
				this.currentPlayer = player;
				this.renderPlayer(player);
				this.stage.setAttribute('aria-busy', 'false');
				this.setStatus(`${player.player_name}, ${this.seasonLabel(season)} loaded.`);
			} catch (error) {
				if (error instanceof DOMException && error.name === 'AbortError') return;
				if (!this.requestIsCurrent(request.controller, request.version)) return;
				this.stage.setAttribute('aria-busy', 'false');
				this.showError(`We couldn’t load ${entry.player_name}’s chart for ${this.seasonLabel(season)}. Try again.`);
			}
		}

		private renderPlayer(player: PlayerPayload) {
			requireElement<HTMLElement>(this, '[data-player-name]').textContent = player.player_name;
			requireElement<HTMLElement>(this, '[data-season]').textContent = this.seasonLabel(
				player.season as SeasonId,
			);
			requireElement<SVGTitleElement>(this, '[data-court-title]').textContent =
				`${player.player_name}, ${player.season}: estimated chance of a make by court area`;
			requireElement<HTMLElement>(this, '[data-caption-player]').textContent =
				`${player.player_name}, ${player.season}.`;
			requireElement<SVGGElement>(this, '[data-court-empty]').setAttribute('hidden', '');
			requireElement<HTMLElement>(this, '[data-result-empty]').hidden = true;
			const controls = requireElement<HTMLFieldSetElement>(this, '[data-view-controls]');
			controls.hidden = false;
			const combined = requireElement<HTMLInputElement>(controls, 'input[value="combined"]');
			combined.checked = true;
			this.courtView = 'combined';

			if (player.relocation_available) this.showQualified(player);
			else this.showInsufficient(player);
			this.setCourtView('combined');
		}

		private setCourtView(view: CourtView) {
			if (!this.currentPlayer) return;
			document.dispatchEvent(new Event('close-definitions'));
			this.courtView = view;
			if (view === 'ability') this.renderHeatmap(this.currentPlayer);
			else if (!this.currentPlayer.relocation_available) this.renderShotChart();
			if (this.currentPlayer.relocation_available) this.updateSlider();
		}

		private clearCourtLayers() {
			requireElement<SVGGElement>(this, '[data-heatmap-cells]').replaceChildren();
			requireElement<SVGGElement>(this, '[data-destination-markers]').replaceChildren();
			requireElement<SVGGElement>(this, '[data-shot-origins]').replaceChildren();
			requireElement<SVGGElement>(this, '[data-shot-dots]').replaceChildren();
		}

		private renderShotChart() {
			if (!this.currentPlayer) return;
			this.clearCourtLayers();
			requireElement<HTMLElement>(this, '[data-map-help]').hidden = true;
			requireElement<HTMLElement>(this, '[data-heat-legend]').hidden = true;
			requireElement<HTMLElement>(this, '[data-shot-legend]').hidden = false;
			const percent = Number(this.slider.value);
			const isAfter = percent > 0;
			this.querySelectorAll<HTMLElement>('[data-relocation-key]').forEach((item) => {
				item.hidden = !isAfter;
			});
			requireElement<HTMLElement>(this, '[data-court-mode-label]').textContent =
				isAfter ? 'Shot locations · after' : 'Shot locations · historical before';
			const guide = requireElement<HTMLElement>(this, '[data-shot-guide]');
			guide.hidden = false;
			guide.textContent = isAfter
				? 'Cyan diamonds show hypothetical new locations; faint rings mark their origins. Green circles and rust crosses show shots that stay. Cyan does not mean a guaranteed make.'
				: 'Recorded shots at 0%: green circles show makes; rust crosses show misses. No shots move.';

			const slider = this.currentPlayer.sliders.find(
				(row) => Math.abs(row.requested_share - percent / 100) < 1e-9,
			);
			if (!slider) throw new Error('Selected slider result is unavailable');
			const origins = requireElement<SVGGElement>(this, '[data-shot-origins]');
			const dots = requireElement<SVGGElement>(this, '[data-shot-dots]');

			this.currentPlayer.shots.forEach((shot) => {
				const movedMass =
					isAfter && shot.move_order !== null
						? Math.max(
								0,
								Math.min(1, slider.actual_relocated_attempt_equivalents - (shot.move_order - 1)),
							)
						: 0;
				if (movedMass > 0 && shot.after_x_ft !== null && shot.after_y_ft !== null) {
					const origin = document.createElementNS(SVG_NS, 'circle');
					origin.setAttribute('cx', String(courtX(shot.x_ft)));
					origin.setAttribute('cy', String(courtY(shot.y_ft)));
					origin.setAttribute('r', '2.8');
					origin.setAttribute('class', 'shot-origin');
					origins.append(origin);

					const x = courtX(shot.after_x_ft);
					const y = courtY(shot.after_y_ft);
					const marker = document.createElementNS(SVG_NS, 'path');
					marker.setAttribute('d', `M${x} ${y - 3.8} L${x + 3.8} ${y} L${x} ${y + 3.8} L${x - 3.8} ${y} Z`);
					marker.setAttribute('class', 'shot-dot shot-dot--moved');
					marker.setAttribute('opacity', String(0.25 + 0.75 * movedMass));
					dots.append(marker);
					return;
				}

				const x = courtX(shot.x_ft);
				const y = courtY(shot.y_ft);
				if (shot.made) {
					const marker = document.createElementNS(SVG_NS, 'circle');
					marker.setAttribute('cx', String(x));
					marker.setAttribute('cy', String(y));
					marker.setAttribute('r', '2.4');
					marker.setAttribute('class', 'shot-dot shot-dot--make');
					dots.append(marker);
				} else {
					const marker = document.createElementNS(SVG_NS, 'path');
					marker.setAttribute('d', `M${x - 2.5} ${y - 2.5} L${x + 2.5} ${y + 2.5} M${x + 2.5} ${y - 2.5} L${x - 2.5} ${y + 2.5}`);
					marker.setAttribute('class', 'shot-dot shot-dot--miss');
					dots.append(marker);
				}
			});

			const title = isAfter
				? `${this.currentPlayer.player_name}, ${this.currentPlayer.season}: after shot locations at ${percent}% requested relocation`
				: `${this.currentPlayer.player_name}, ${this.currentPlayer.season}: historical before shot locations`;
			requireElement<SVGTitleElement>(this, '[data-court-title]').textContent = title;
			requireElement<SVGDescElement>(this, '[data-court-description]').textContent =
				!isAfter
					? `Past shots at 0%: ${this.currentPlayer.observed_attempts} attempts. Green circles are makes and rust crosses are misses.`
					: `Up to ${percent} percent of shots requested to move. Unmoved shots keep their colors. Cyan diamonds show possible new locations and faint rings show where those shots started. Cyan does not mean a guaranteed make.`;
			requireElement<HTMLElement>(this, '[data-cell-detail]').textContent =
				!isAfter
					? `Before: ${whole(this.currentPlayer.observed_attempts)} past shots, with ${whole(this.currentPlayer.makes)} makes and ${whole(this.currentPlayer.misses)} misses. At 0%, no shots move. Makes and misses do not decide which shots move.`
					: `Up to ${percent}% requested; ${oneDecimal(slider.actual_relocated_share * 100)}% moved in this estimate. Cyan diamonds show possible new locations. Faint rings show where those shots started. Cyan does not mean a guaranteed make.`;
			requireElement<HTMLElement>(this, '[data-caption-body]').textContent =
				!isAfter
					? 'Before: past shots at 0%. Green circles are makes; rust crosses are misses.'
					: `After: up to ${percent}% requested. Cyan diamonds show possible new locations; faint rings mark the original locations.`;
		}

		private renderHeatmap(player: PlayerPayload) {
			this.clearCourtLayers();
			requireElement<HTMLElement>(this, '[data-map-help]').hidden = false;
			requireElement<HTMLElement>(this, '[data-shot-guide]').hidden = true;
			const cellsLayer = requireElement<SVGGElement>(this, '[data-heatmap-cells]');
			const markersLayer = requireElement<SVGGElement>(this, '[data-destination-markers]');
			requireElement<HTMLElement>(this, '[data-heat-legend]').hidden = false;
			requireElement<HTMLElement>(this, '[data-shot-legend]').hidden = true;
			requireElement<HTMLElement>(this, '[data-court-mode-label]').textContent =
				'Make-chance map · estimated ability';
			requireElement<SVGTitleElement>(this, '[data-court-title]').textContent =
				`${player.player_name}, ${player.season}: estimated chance of a make by court area`;
			requireElement<SVGDescElement>(this, '[data-court-description]').textContent =
				'A shooting map with 156 court areas. Darker areas mean a higher estimated chance of a make. Focus the court and use the arrow keys to inspect areas.';
			requireElement<HTMLElement>(this, '[data-caption-body]').textContent =
				'Colors show the estimated chance of a make. Outlined diamonds mark areas with evidence for moving shots.';

			player.heatmap_cells.forEach((cell, index) => {
				const rect = document.createElementNS(SVG_NS, 'rect');
				rect.setAttribute('x', String(courtX(cell.x_min_ft)));
				rect.setAttribute('y', String(courtY(cell.y_max_ft)));
				rect.setAttribute('width', String((cell.x_max_ft - cell.x_min_ft) * 10));
				rect.setAttribute('height', String((cell.y_max_ft - cell.y_min_ft) * 10));
				rect.setAttribute('fill', HEAT_COLOURS[heatBin(cell.modeled_make_probability)]);
				rect.setAttribute('class', 'heat-cell');
				rect.setAttribute('data-cell-index', String(index));
				const title = document.createElementNS(SVG_NS, 'title');
				title.textContent = this.cellDescription(cell);
				rect.append(title);
				rect.addEventListener('pointerenter', () => this.showCell(index));
				rect.addEventListener('click', () => this.showCell(index));
				cellsLayer.append(rect);

				if (cell.supported_destination) {
					const centerX = (courtX(cell.x_min_ft) + courtX(cell.x_max_ft)) / 2;
					const centerY = (courtY(cell.y_min_ft) + courtY(cell.y_max_ft)) / 2;
					const marker = document.createElementNS(SVG_NS, 'path');
					marker.setAttribute(
						'd',
						`M${centerX} ${centerY - 6} L${centerX + 6} ${centerY} L${centerX} ${centerY + 6} L${centerX - 6} ${centerY} Z`,
					);
					marker.setAttribute('class', 'destination-marker');
					markersLayer.append(marker);
				}
			});

			this.activeCellIndex = 0;
			requireElement<HTMLElement>(this, '[data-cell-detail]').textContent =
				'Point to an area, tap it, or focus the court and use the arrow keys to read its estimate.';
		}

		private cellDescription(cell: HeatmapCell) {
			const support = cell.supported_destination
				? 'This area has evidence for moving shots.'
				: 'This area does not pass the rules for moving shots.';
			const attemptLabel = cell.observed_attempts === 1 ? 'attempt' : 'attempts';
			return `Area ${cell.cell_id}: ${probabilityPercent(cell.modeled_make_probability)} estimated chance of a make; estimated range (90%) ${probabilityPercent(cell.make_probability_lower_90)} to ${probabilityPercent(cell.make_probability_upper_90)}; ${whole(cell.observed_attempts)} past ${attemptLabel}. ${support}`;
		}

		private showCell(index: number) {
			if (!this.currentPlayer) return;
			const bounded = Math.max(0, Math.min(this.currentPlayer.heatmap_cells.length - 1, index));
			this.activeCellIndex = bounded;
			this.querySelectorAll('.heat-cell').forEach((cell) => cell.classList.remove('is-active'));
			this.querySelector(`[data-cell-index="${bounded}"]`)?.classList.add('is-active');
			requireElement<HTMLElement>(this, '[data-cell-detail]').textContent = this.cellDescription(
				this.currentPlayer.heatmap_cells[bounded],
			);
		}

		private moveCell(event: KeyboardEvent) {
			if (!this.currentPlayer || this.courtView !== 'ability') return;
			const moves: Record<string, number> = {
				ArrowLeft: -1,
				ArrowRight: 1,
				ArrowUp: 13,
				ArrowDown: -13,
			};
			const move = moves[event.key];
			if (move === undefined) return;
			event.preventDefault();
			this.showCell(this.activeCellIndex + move);
		}

		private showQualified(player: PlayerPayload) {
			const qualified = requireElement<HTMLElement>(this, '[data-qualified-result]');
			const insufficient = requireElement<HTMLElement>(this, '[data-insufficient-result]');
			qualified.hidden = false;
			requireElement<HTMLElement>(this, '[data-metrics-result]').hidden = false;
			insufficient.hidden = true;
			this.slider.disabled = false;
			this.slider.value = '0';
			const evidenceNote = requireElement<HTMLElement>(this, '[data-evidence-note]');
			evidenceNote.hidden = player.evidence_status !== 'single_destination';

			const { point, lower_90, upper_90 } = player.score;
			if (
				!isFiniteNumber(point) ||
				!isFiniteNumber(lower_90) ||
				!isFiniteNumber(upper_90)
			) {
				throw new Error('Available player score is unavailable');
			}
			requireElement<HTMLElement>(this, '[data-score]').textContent = oneDecimal(point);
			this.updateHelp('score', 'Shot Selection Score',
				`A score of ${oneDecimal(point)} means the past mix produces about ${oneDecimal(point)}% of the estimated points per shot in the 25%-request scenario. Higher means less estimated room to improve; this is not a league rank or overall player rating.`);
			requireElement<HTMLElement>(this, '[data-score-interval]').textContent =
				`${oneDecimal(lower_90)} to ${oneDecimal(upper_90)}`;
			this.updateSlider();
		}

		private showInsufficient(player: PlayerPayload) {
			requireElement<HTMLElement>(this, '[data-qualified-result]').hidden = true;
			requireElement<HTMLElement>(this, '[data-metrics-result]').hidden = true;
			const unavailable = requireElement<HTMLElement>(this, '[data-insufficient-result]');
			unavailable.hidden = false;
			const title = requireElement<HTMLElement>(unavailable, '[data-unavailable-title]');
			const copy = requireElement<HTMLElement>(unavailable, '[data-unavailable-copy]');
			if (player.availability_reason === 'no_positive_supported_capacity') {
				title.textContent = 'No Room to Move More Shots';
				copy.textContent =
					'One area passes the evidence rules, but it already holds at least half of this player’s shots. The 50% limit leaves no room to add shots there, so no extra-points estimate or score is available.';
			} else if (player.availability_reason === 'no_eligible_weak_source_mass') {
				title.textContent = 'No Weaker Source Areas';
				copy.textContent =
					'Some areas pass the evidence rules, but none of this player’s shots come from areas below their current average expected points per shot. No extra-points estimate or score is available.';
			} else {
				title.textContent = 'No Clear Area for Moving Shots';
				copy.textContent =
					'No area has both enough shots and enough evidence of an advantage over this player’s current shot mix. You can still view their past shots and Make-chance map, but no extra-points estimate or score is available.';
			}
			this.slider.disabled = true;
			this.slider.value = '0';
		}

		private showSeasonUnavailable(
			playerName: string,
			season: SeasonId,
			availability: PlayerSeasonAvailability,
		) {
			this.stage.setAttribute('aria-busy', 'false');
			requireElement<HTMLElement>(this, '[data-result-empty]').hidden = true;
			const unavailable = requireElement<HTMLElement>(this, '[data-season-unavailable]');
			unavailable.hidden = false;
			requireElement<HTMLElement>(unavailable, '[data-season-unavailable-title]').textContent =
				`${playerName} · ${this.seasonLabel(season)}`;
			const copy = requireElement<HTMLElement>(unavailable, '[data-season-unavailable-copy]');

			if (availability.availability_status === 'no_recorded_shots') {
				copy.textContent =
					`The data has no recorded shots for ${playerName} in ${this.seasonLabel(season)}. Choose another season or player, or reset to LeBron James.`;
			} else if (availability.availability_status === 'model_ineligible') {
				const attempts = whole(availability.in_play_shots);
				const games = whole(availability.in_play_games);
				let threshold = 'the 20-game and 250-attempt thresholds';
				if (availability.availability_reason === 'fewer_than_20_games') {
					threshold = 'the 20-game threshold';
				} else if (availability.availability_reason === 'fewer_than_250_attempts') {
					threshold = 'the 250-attempt threshold';
				}
				copy.textContent =
					`${playerName} has ${attempts} eligible shots across ${games} games in ${this.seasonLabel(season)}. That falls short of ${threshold}, so no chart is available. Choose another season or player.`;
			} else {
				copy.textContent =
					`A shooting map exists for ${playerName} in ${this.seasonLabel(season)}, but no area passes the rules for moving shots.`;
			}

			requireElement<HTMLElement>(this, '[data-caption-player]').textContent =
				`${playerName}, ${this.seasonLabel(season)}.`;
			requireElement<HTMLElement>(this, '[data-caption-body]').textContent =
				'No chart is available for this player in this season.';
			this.setStatus(
				`No analysis for ${playerName} in ${this.seasonLabel(season)}. Choose another player or season, or reset the explorer.`,
			);
		}

		private updateSlider() {
			if (!this.currentPlayer?.relocation_available) return;
			const percent = Number(this.slider.value);
			const share = percent / 100;
			const result = this.currentPlayer.sliders.find(
				(row) => Math.abs(row.requested_share - share) < 1e-9,
			);
			if (!result) throw new Error('Selected slider result is unavailable');
			const values = [
				result.season_gain.mean,
				result.season_gain.lower_90,
				result.season_gain.upper_90,
				result.gain_per_100.mean,
				result.gain_per_100.lower_90,
				result.gain_per_100.upper_90,
			];
			if (!values.every(isFiniteNumber)) throw new Error('Selected slider result is unavailable');

			const [season, seasonLow, seasonHigh, per100, per100Low, per100High] = values as number[];
			requireElement<HTMLOutputElement>(this, '[data-slider-output]').textContent = `Up to ${percent}%`;
			this.slider.setAttribute('aria-valuetext', `Up to ${percent} percent requested; ${oneDecimal(result.actual_relocated_share * 100)} percent moved`);
			requireElement<HTMLElement>(this, '[data-actual-share]').textContent =
				`${oneDecimal(result.actual_relocated_share * 100)}% moved in this estimate`;
			requireElement<HTMLElement>(this, '[data-season-gain]').textContent =
				`${signed(season, 0)} points`;
			requireElement<HTMLElement>(this, '[data-season-interval]').textContent =
				`${whole(seasonLow)} to ${whole(seasonHigh)} points`;
			requireElement<HTMLElement>(this, '[data-per-100-gain]').textContent =
				`${signed(per100, 1)} points`;
			requireElement<HTMLElement>(this, '[data-per-100-interval]').textContent =
				`${oneDecimal(per100Low)} to ${oneDecimal(per100High)} points`;
			const seasonName = this.seasonLabel(this.currentPlayer.season as SeasonId);
			requireElement<HTMLElement>(this, '[data-moved-count]').textContent =
				`Equal to ${result.actual_relocated_attempt_equivalents.toFixed(2)} shots in the calculation`;
			requireElement<HTMLElement>(this, '[data-fraction-note]').hidden =
				this.courtView !== 'combined' || Math.abs(result.actual_relocated_attempt_equivalents - Math.round(result.actual_relocated_attempt_equivalents)) < 1e-9;
			const capNote = requireElement<HTMLElement>(this, '[data-cap-note]');
			capNote.hidden = result.actual_relocated_share + 1e-9 >= share;
			capNote.textContent = `You asked for ${percent}%. The model can move ${oneDecimal(result.actual_relocated_share * 100)}% before suitable source shots or receiving-area space runs out.`;
			requireElement<HTMLElement>(this, '[data-season-note]').textContent =
				`Over the same ${whole(this.currentPlayer.observed_attempts)} recorded shots. This is not a forecast of a future season.`;
			this.updateHelp('shots-to-move', 'Shots to Move',
				`Your ${percent}% setting allows up to ${percent} of every 100 shots to move. The amount moved can be lower because suitable shots or room in receiving areas can run out.`);
			this.updateHelp('season-gain', `Extra Points in ${seasonName}`,
				`The model estimates ${signed(season, 0)} extra points over the same ${whole(this.currentPlayer.observed_attempts)} recorded shots in ${seasonName}. This compares possible shot mixes, not a future season forecast.`);
			this.updateHelp('range', 'Estimated Range (90%)',
				`The middle 90% of the model’s estimates run from ${whole(seasonLow)} to ${whole(seasonHigh)} extra points. This range describes uncertainty within the model, not a guarantee about real games.`);
			requireElement<HTMLButtonElement>(this, '[data-term="range"] button').setAttribute('aria-label', `Explain Estimated Range for Extra Points in ${seasonName}`);
			this.updateHelp('per-100', 'Extra Points per 100 Shots',
				`The model estimates ${signed(per100, 1)} extra points for every 100 attempts at this slider setting. This puts players with different shot counts on the same scale.`);
			if (this.courtView === 'combined') {
				this.renderShotChart();
			}
		}

		private updateHelp(term: string, label: string, explanation: string) {
			const help = requireElement<HTMLElement>(this, `[data-term="${term}"]`);
			if (!help.querySelector('.compact')) requireElement<HTMLElement>(help, '[data-help-label]').textContent = label;
			requireElement<HTMLButtonElement>(help, 'button').setAttribute('aria-label', `Explain ${label}`);
			requireElement<HTMLElement>(help, '[data-help-copy]').textContent = explanation;
			help.dispatchEvent(new Event('definition-update'));
		}

		private clearResult(playerName: string, message: string) {
			document.dispatchEvent(new Event('close-definitions'));
			requireElement<HTMLElement>(this, '[data-shot-guide]').hidden = true;
			requireElement<HTMLElement>(this, '[data-map-help]').hidden = true;
			requireElement<HTMLElement>(this, '[data-cell-detail]').textContent = message;
			requireElement<SVGDescElement>(this, '[data-court-description]').textContent = message;
			this.currentPlayer = undefined;
			this.courtView = 'combined';
			this.slider.value = '0';
			requireElement<HTMLOutputElement>(this, '[data-slider-output]').textContent = 'Up to 0%';
			requireElement<HTMLElement>(this, '[data-court-mode-label]').textContent = 'Player chart';
			requireElement<HTMLElement>(this, '[data-player-name]').textContent = playerName;
			requireElement<HTMLElement>(this, '[data-caption-player]').textContent =
				`${playerName}, ${this.seasonLabel(this.selectedSeason)}.`;
			requireElement<HTMLElement>(this, '[data-caption-body]').textContent = message;
			requireElement<SVGTitleElement>(this, '[data-court-title]').textContent = message;
			requireElement<SVGGElement>(this, '[data-court-empty]').removeAttribute('hidden');
			requireElement<SVGTextElement>(this, '[data-court-empty] text').textContent = message;
			this.clearCourtLayers();
			requireElement<HTMLFieldSetElement>(this, '[data-view-controls]').hidden = true;
			requireElement<HTMLElement>(this, '[data-heat-legend]').hidden = true;
			requireElement<HTMLElement>(this, '[data-shot-legend]').hidden = true;
			requireElement<HTMLElement>(this, '[data-qualified-result]').hidden = true;
			requireElement<HTMLElement>(this, '[data-metrics-result]').hidden = true;
			requireElement<HTMLElement>(this, '[data-insufficient-result]').hidden = true;
			requireElement<HTMLElement>(this, '[data-season-unavailable]').hidden = true;
			const empty = requireElement<HTMLElement>(this, '[data-result-empty]');
			empty.hidden = false;
			empty.querySelector('p:last-child')!.textContent = message;
			this.slider.disabled = true;
		}

		private setStatus(message: string) {
			this.status.textContent = message;
			this.status.setAttribute('role', 'status');
			this.status.dataset.kind = 'status';
		}

		private showError(message: string) {
			this.stage.setAttribute('aria-busy', 'false');
			this.status.textContent = message;
			this.status.setAttribute('role', 'alert');
			this.status.dataset.kind = 'error';
			const courtEmpty = requireElement<SVGGElement>(this, '[data-court-empty]');
			courtEmpty.removeAttribute('hidden');
			requireElement<SVGTextElement>(courtEmpty, 'text').textContent = 'Chart unavailable';
			const resultEmpty = requireElement<HTMLElement>(this, '[data-result-empty]');
			resultEmpty.hidden = false;
			resultEmpty.querySelector('p:last-child')!.textContent = 'Chart unavailable';
			this.retry.hidden = false;
		}
	}

	if (!customElements.get('spatial-shot-explorer')) {
		customElements.define('spatial-shot-explorer', SpatialShotExplorer);
	}
</script>

