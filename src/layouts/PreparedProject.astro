---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { PreparedProject } from '../lib/prepared-projects';
interface Props { page: PreparedProject }
const { page } = Astro.props;
// Retain the export's skip links, main content and trailing engine scripts.
const parts = page.body.match(/^([\s\S]*?)<header\b[^>]*>[\s\S]*?<\/header>([\s\S]*?)<footer\b[^>]*>[\s\S]*?<\/footer>([\s\S]*)$/);
if (!parts) throw new Error(`Unrecognized project shell: ${page.slug}`);
const [, beforeHeader, content, afterFooter] = parts;
for (const hash of page.scriptHashes) Astro.csp?.insertScriptHash(hash);
for (const hash of page.styleHashes) Astro.csp?.insertStyleHash(hash);
---
<!doctype html>
<html lang="en">
  <head>
    <Fragment set:html={page.head} />
    <link rel="stylesheet" href="/portfolio-shell.css" />
    {['shots', 'comparison'].includes(page.kind) && <link rel="stylesheet" href="/shot-court-viewport.css" />}
  </head>
  <body class={page.bodyClass} data-project={page.kind}>
    <Fragment set:html={beforeHeader} />
    <Header />
    <Fragment set:html={content} />
    <Footer project={page.title} credit={page.kind === 'rally'} />
    <Fragment set:html={afterFooter} />
  </body>
</html>
