---
// Internal reference page for the colour and type system.
//
// Deliberately unlinked: absent from the nav, filtered out of the sitemap in
// astro.config.mjs, and never in the RSS feed (rss.xml.js reads the blog
// collection only). Not public content.
//
// This page declares no colour, type, or spacing values of its own. Everything
// renders from the tokens in global.css, so it is a live specimen rather than a
// copy that can drift. Swatch hexes are read from the computed custom property
// at runtime for the same reason.
import BaseHead from '../components/BaseHead.astro';

const swatches = [
	['--cream', 'Cream', 'page ground'],
	['--sand', 'Sand', 'second surface: plot areas, zebra rows, pulled-out sections'],
	['--green', 'Green', 'type, rules, full-bleed blocks'],
	['--accent', 'Accent', 'rust: links, active nav, third chart series'],
	['--muted', 'Muted', 'secondary type on green blocks only'],
];

const scale = [
	['--type-display', '.display', '5.625rem', '90', '4.50', 'opsz 144, SOFT 100, WONK 1'],
	['--type-h1', 'h1', '4.21875rem', '67.5', '3.375', 'opsz 96, SOFT 100, WONK 1'],
	['--type-h2', 'h2', '2.8125rem', '45', '2.25', 'opsz 72, SOFT 80, WONK 1'],
	['--type-h3', 'h3', '1.875rem', '30', '1.50', 'opsz 36, SOFT 0, WONK 0'],
	['--type-body', 'body', '1.25rem', '20', '1.00', 'Source Serif 4'],
	['--type-small', 'small', '0.9375rem', '15', '0.75', 'Source Serif 4'],
	['--type-label', '.label', '0.75rem', '12', '0.60', 'IBM Plex Mono'],
];

const ratios = [
	['Green on cream', '7.52', 'AAA'],
	['Accent on cream', '5.59', 'AA text'],
	['Cream on green', '7.52', 'AAA'],
	['Muted on green', '4.85', 'AA text'],
	['Green on sand', '5.01', 'AA text'],
	['Accent on sand', '3.72', 'graphic only'],
	['Cream / sand step', '1.50', 'surfaces read apart'],
	['Accent on green', '1.34', 'banned'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Style guide — colour and type"
			description="Internal reference for the colour and type system."
		/>
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body>
		<main class="wide">
			<p class="label">Style guide</p>
			<h1 class="display">Cream as a surface, not an off-white</h1>
			<p class="lede">
				Every value on this page comes from the tokens in <code>global.css</code>. Nothing is
				hardcoded here, so if the system moves, this page moves with it.
			</p>

			<h2>Palette</h2>
			<ul class="chips">
				{
					swatches.map(([token, name, role]) => (
						<li class="chip">
							<i style={`background: var(${token})`}></i>
							<b class="label">{name}</b>
							<span class="numeric" data-token={token}>
								&nbsp;
							</span>
							<em>{role}</em>
						</li>
					))
				}
			</ul>

			<h2>Type scale</h2>
			<p>
				Ratio 1.5 on a 20px body, derived by calc from a single ratio token. Display is
				pinned at 90px rather than being the run's next step: in a pure geometric run
				display over h1 is the ratio itself, which left a cliff below the largest size.
				Pinning it and letting the run climb to 67.5px closes that drop to 1.33 while
				h1, h2, and h3 stay exactly 1.5 apart. Wonk is on at h2 and above and flat below,
				where the wonky letterforms stop reading as intentional.
			</p>

			<!-- Specimens use .h1 / .h2 / .h3 rather than real headings so the page
			     keeps a single h1 and a sane outline. -->
			<div class="specimens">
				<p class="display">Possession</p>
				<p class="h1">Possession value</p>
				<p class="h2">Possession value by lineup</p>
				<p class="h3">Method and its problems</p>
				<p>
					Body copy in Source Serif 4 at 20px on 1.6, holding the measure near 60
					characters. An <a href="#accent">inline link carries the accent</a> at 5.59:1
					against this ground, which clears AA for body text. Hover floods the accent
					behind cream type.
				</p>
				<p class="small">Small text at 15px, for captions and secondary notes.</p>
				<p class="label">Label at 12px, mono, uppercase, tracked</p>
			</div>

			<table>
				<caption>Scale and axis settings</caption>
				<thead>
					<tr>
						<th>Token</th>
						<th>Role</th>
						<th class="n">rem</th>
						<th class="n">px</th>
						<th class="n">&times; body</th>
						<th>Axes</th>
					</tr>
				</thead>
				<tbody>
					{
						scale.map(([token, role, rem, px, mult, axes]) => (
							<tr>
								<td><code>{token}</code></td>
								<td>{role}</td>
								<td class="n">{rem}</td>
								<td class="n">{px}</td>
								<td class="n">{mult}</td>
								<td>{axes}</td>
							</tr>
						))
					}
				</tbody>
			</table>

			<h2>Bands and offsets</h2>
			<p>
				The page is a stack of full-width bands. Content sits at a different horizontal
				offset in each, so the eye zigzags down the page. Offsets exist only above 48rem;
				narrow gets one consistent inset. Green is structural, budgeted at one band per
				ordinary page plus the footer, two plus the footer on a project page.
			</p>
			<div class="offset-demo">
				<p class="label at-edge">at-edge &middot; flush to the inset</p>
				<p class="label at-step">at-step &middot; one offset step</p>
				<p class="label at-deep">at-deep &middot; pushed well right</p>
			</div>

			<h2>Green band</h2>
			<div class="band band--green bleed">
				<div class="band-inner at-step">
					<p class="label">Constraint 1</p>
					<p>
						Green with cream type at 7.52:1. The accent is absent here on purpose: it
						measures 1.34:1 against the green, which is invisible. Green bands take cream
						or muted for type and nothing else.
					</p>
					<p class="dim small">Muted carries dates and bylines at 4.85:1 on green.</p>
				</div>
			</div>

			<h2>Measured ratios</h2>
			<table>
				<caption>Every pair, computed not estimated</caption>
				<thead>
					<tr>
						<th>Pair</th>
						<th class="n">Ratio</th>
						<th>Verdict</th>
					</tr>
				</thead>
				<tbody>
					{
						ratios.map(([pair, ratio, verdict]) => (
							<tr>
								<td>{pair}</td>
								<td class="n">{ratio}</td>
								<td class={verdict === 'banned' ? 'label banned' : 'label'}>{verdict}</td>
							</tr>
						))
					}
				</tbody>
			</table>

			<h2>Plot surface</h2>
			<p>
				Figures never take an offset. Every figure on a page sits at one fixed left
				inset while the prose bands zigzag around it, so the figure numbers align down
				the page and the charts become the stable spine the moving text reads against.
				A figure inside a prose band cancels that band's offset to get back to the
				gutter, and it outgrows the text measure so the chart is the widest element on
				the page.
			</p>
			<figure class="figure">
				<div class="plot">
					<svg
						viewBox="0 0 420 240"
						role="img"
						aria-label="Mark specimen: three series distinguished by colour and shape on the sand surface."
					>
						<g stroke="var(--green)" stroke-opacity="0.16" stroke-width="1">
							<line x1="34" y1="30" x2="410" y2="30" />
							<line x1="34" y1="76" x2="410" y2="76" />
							<line x1="34" y1="122" x2="410" y2="122" />
							<line x1="34" y1="168" x2="410" y2="168" />
						</g>
						<line x1="34" y1="206" x2="410" y2="206" stroke="var(--green)" stroke-width="2" />
						<line x1="34" y1="24" x2="34" y2="206" stroke="var(--green)" stroke-width="2" />
						<!-- font-family comes from CSS because SVG presentation attributes
						     do not resolve var(). font-size stays an attribute because
						     inside a scaled viewBox it is geometry in user units, like the
						     r and stroke-width above, not a type token. -->
						<g class="axis-labels" fill="var(--green)" font-size="10">
							<text x="8" y="34">40</text>
							<text x="8" y="126">20</text>
							<text x="12" y="210">0</text>
						</g>
						<g fill="var(--green)" fill-opacity="0.75">
							<circle cx="72" cy="176" r="5" />
							<circle cx="108" cy="150" r="5" />
							<circle cx="141" cy="161" r="5" />
							<circle cx="176" cy="121" r="5" />
							<circle cx="212" cy="132" r="5" />
							<circle cx="247" cy="96" r="5" />
						</g>
						<g fill="var(--accent)" fill-opacity="0.85">
							<polygon points="130,120 136,131 124,131" />
							<polygon points="168,96 174,107 162,107" />
							<polygon points="205,104 211,115 199,115" />
							<polygon points="243,71 249,82 237,82" />
							<polygon points="281,80 287,91 275,91" />
							<polygon points="322,52 328,63 316,63" />
						</g>
						<g fill="none" stroke="var(--green)" stroke-width="2">
							<rect x="256" y="150" width="9" height="9" />
							<rect x="292" y="132" width="9" height="9" />
							<rect x="329" y="141" width="9" height="9" />
							<rect x="365" y="112" width="9" height="9" />
						</g>
					</svg>
				</div>
				<figcaption>
					<b class="label">Mark specimen. Not data.</b> Constraint 2 in practice: three series
					separate by green, accent, and open-square shape, never by two greens. Gridlines
					sit at 16% green so they stay under the marks.
				</figcaption>
			</figure>
		</main>

		<script>
			// Read swatch hexes from the computed tokens so this page can never
			// disagree with global.css.
			const root = getComputedStyle(document.documentElement);
			document.querySelectorAll<HTMLElement>('[data-token]').forEach((el) => {
				const name = el.dataset.token;
				if (name) el.textContent = root.getPropertyValue(name).trim().toUpperCase();
			});
		</script>

		<style>
			/* Layout only. No colour, type, or spacing literals: every value below is
			   a token from global.css. */
			main.wide {
				width: 100%;
				max-width: 68rem;
				padding: var(--space-xl) var(--space-m);
			}
			/* The specimen page keeps a constrained main so the reference reads as a
			   document. A band inside it escapes that constraint to show what a real
			   full-bleed band does, without needing a second main element. */
			.bleed {
				margin-inline: calc(-1 * var(--space-m));
				padding-block: var(--space-l);
			}
			.offset-demo p {
				margin: 0 0 var(--space-2xs) 0;
				padding-block: var(--space-3xs);
				border-left: var(--rule) solid var(--accent);
				padding-left: var(--space-2xs);
			}
			.lede {
				max-width: 60ch;
			}
			h2 {
				margin-top: var(--space-xl);
				padding-bottom: var(--space-2xs);
				border-bottom: var(--rule) solid var(--green);
			}
			.chips {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
				gap: var(--space-m);
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.chip i {
				display: block;
				height: var(--space-xl);
				border: var(--rule-thin) solid var(--green);
			}
			.chip b {
				display: block;
				margin-top: var(--space-2xs);
			}
			.chip span {
				display: block;
			}
			.chip em {
				display: block;
				font-size: var(--type-small);
				font-style: normal;
			}
			.specimens > * {
				margin-bottom: var(--space-m);
			}
			.specimens p:not(.display):not(.label):not(.small) {
				max-width: 60ch;
			}
			.reverse p {
				max-width: 58ch;
			}
			.reverse p:last-child {
				margin-bottom: 0;
			}
			.axis-labels {
				font-family: var(--font-numeric);
			}
			.banned {
				color: var(--accent);
			}
		</style>
	</body>
</html>
